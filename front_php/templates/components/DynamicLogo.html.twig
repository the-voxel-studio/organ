<div class="dynamic-logo-visual-container" style="width: {{ size|default('400px') }}; height: {{ size|default('400px') }};">
    <style>
        .dynamic-logo-visual-container {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Le style commun aux couches de vagues */
        .dynamic-logo-wave {
            position: absolute;
            width: 100%;
            height: 100%;
            /* On utilise un border-radius très fluide */
            border-radius: 43% 57% 41% 59% / 57% 45% 55% 43%;
            transition: all 0.5s ease-in-out;
            will-change: border-radius, transform;
        }

        /* Couche 1 : La plus lente et foncée */
        .dynamic-logo-wave.-one {
            background: var(--bubblegum);
            opacity: 1;
            animation: dynamic-logo-drift 7s infinite linear, dynamic-logo-morph 12s infinite linear;
        }

        /* Couche 2 : Vitesse moyenne, couleur plus claire */
        .dynamic-logo-wave.-two {
            background: var(--bubblegum);
            opacity: 0.6;
            animation: dynamic-logo-drift 11s infinite linear, dynamic-logo-morph 15s infinite reverse;
        }

        /* Couche 3 : La plus rapide pour l'irrégularité */
        .dynamic-logo-wave.-three {
            background: var(--bubblegum);
            opacity: 0.4;
            animation: dynamic-logo-drift 15s infinite linear, dynamic-logo-morph 8s infinite cubic-bezier(0.445, 0.05, 0.55, 0.95);
        }

        /* Animation de rotation fluide */
        @keyframes dynamic-logo-drift {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Animation de déformation des vagues (Smooth Morphing) */
        @keyframes dynamic-logo-morph {
            0%, 100% { border-radius: 40% 60% 40% 60% / 60% 40% 60% 40%; }
            20% { border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%; }
            40% { border-radius: 45% 55% 35% 65% / 55% 40% 70% 30%; }
            60% { border-radius: 55% 45% 65% 35% / 65% 35% 45% 55%; }
            80% { border-radius: 35% 65% 45% 55% / 40% 60% 55% 45%; }
        }

        .dynamic-logo-organ-line {
            fill: white;
            stroke: none;
            stroke-width: 4;
            stroke-linecap: round;
            stroke-linejoin: round;
            width: 100%;
            height: 100%;
        }

        .dynamic-logo-svg {
            width: 65%;
            height: 65%;
            z-index: 15;
            filter: drop-shadow(0px 15px 20px var(--white) 50%);
        }
    </style>

    <div class="dynamic-logo-wave -one"></div>
    <div class="dynamic-logo-wave -two"></div>
    <div class="dynamic-logo-wave -three"></div>
    
