    <script type="module">
        import gsap from 'gsap';
        import MorphSVGPlugin from 'gsap/MorphSVGPlugin';

        (function() {
            const id = '{{ id|default("main") }}';
            const initLogo = () => {
                gsap.registerPlugin(MorphSVGPlugin);
                MorphSVGPlugin.convertToPath("circle");
                
                const tl = gsap.timeline({ repeat: -1, yoyo: false });

                tl.from("#active-shape-" + id, {
                    duration: 2,
                    ease: "back.inOut(1.2)"
                })
                .to("#active-shape-" + id, {
                    duration: 2,
                    morphSVG: "#brain-" + id,
                    ease: "back.inOut(1.2)"
                }, "+=1")
                .to("#active-shape-" + id, {
                    duration: 2,
                    morphSVG: "#lungs-" + id,
                    ease: "back.inOut(1.2)"
                }, "+=1")
                .to("#active-shape-" + id, {
                    duration: 2,
                    morphSVG: "#stomach-" + id,
                    ease: "back.inOut(1.2)"
                }, "+=1")
                .to("#active-shape-" + id, {
                    duration: 2,
                    morphSVG: "#heart-" + id,
                    ease: "back.inOut(1.2)"
                }, "+=1")
                .to("#active-shape-" + id, {
                    duration: 2,
                    morphSVG: "#circle-ref-" + id,
                    ease: "back.inOut(1.2)"
                }, "+=1");

                gsap.to("#logo-organ-" + id, {
                    scale: 1.05,
                    duration: 1.5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut"
                });
            };
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLogo);
            } else {
                initLogo();
            }
        })();
    </script>
