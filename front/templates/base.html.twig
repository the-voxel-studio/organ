<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="{% block html_class %}scroll-smooth{% endblock %}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Organ{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
            {% block extra_javascripts %}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}min-h-screen bg-white text-gray-900 font-sans antialiased{% endblock %}" {% block body_attrs %}{% endblock %}>
        {% block layout %}{% endblock %}
        {% block modals %}{% endblock %}
    </body>
</html>
