        {{ 'terms.intro'|trans({}, 'legal') }}
    </p>

    <div class="space-y-16">
        <section>
            <h2 class="text-2xl font-black uppercase tracking-widest text-bubblegum mb-6">{{ 'terms.service.title'|trans({}, 'legal') }}</h2>
            <p class="text-gray-600 leading-relaxed text-lg">{{ 'terms.service.content'|trans({}, 'legal') }}</p>
        </section>

        <section>
            <h2 class="text-2xl font-black uppercase tracking-widest text-bubblegum mb-6">{{ 'terms.access.title'|trans({}, 'legal') }}</h2>
