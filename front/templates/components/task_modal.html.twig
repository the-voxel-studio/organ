<div class="fixed inset-0 z-[100] hidden flex justify-end"
     data-task-modal-target="container">
    
    {# Backdrop #}
    <div data-task-modal-target="backdrop"
         data-action="click->task-modal#close"
         class="fixed inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-auto"></div>

    {# Panel #}
    <div data-task-modal-target="panel"
         class="relative w-full md:w-[600px] lg:w-[800px] bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col h-full pointer-events-auto">
        
        {# Header #}
        <header class="p-6 border-b border-gray-100 flex items-center justify-between shrink-0 bg-white z-10">
            <div class="flex flex-col">
                <h2 class="text-xl font-bold text-black" data-task-modal-target="modalTitle">
                    {{ 'task.modal.create_title'|trans }}
                </h2>
                <div data-task-modal-target="taskMeta" class="hidden flex items-center gap-2 mt-1">
                    <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest" data-task-modal-target="taskUuid"></span>
                    <span class="text-[10px] font-bold text-gray-300">•</span>
                    <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest" data-task-modal-target="taskCreatedAt"></span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button data-task-modal-target="restoreBtn" data-action="click->task-modal#restoreTask" class="hidden px-4 py-2 bg-black text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h10a8 8 0 018 8v2M3 10l5 5m-5-5l5-5"/></svg>
                    Restaurer
                </button>
                <button data-task-modal-target="deleteBtn" data-action="click->task-modal#deleteTask" class="hidden p-2 text-rose-500 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer" title="{{ 'task.modal.buttons.delete'|trans }}">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
                <button data-action="click->task-modal#close" class="p-2 hover:bg-gray-100 rounded-xl transition-colors cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </header>

        {# Content #}
        <div class="flex-grow overflow-y-auto custom-scrollbar bg-gray-50/30">
             <div class="p-8 space-y-12 pb-32">
                 {# Skeleton Loader #}
                 <div data-task-modal-target="loader" class="hidden space-y-8 animate-pulse">
                     <div class="h-10 bg-gray-200 rounded-2xl w-3/4"></div>
                     <div class="h-40 bg-gray-200 rounded-2xl"></div>
                     <div class="grid grid-cols-2 gap-8">
                         <div class="h-12 bg-gray-200 rounded-2xl"></div>
                         <div class="h-12 bg-gray-200 rounded-2xl"></div>
                     </div>
                 </div>

                 {# Form Content #}
                 <div data-task-modal-target="formContent" class="space-y-12">
                     <form data-action="submit->task-modal#save" class="space-y-8" data-task-modal-target="form">
                         {# Title #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="title">
                         <div class="flex items-center justify-between ml-1">
                            <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.title'|trans }}</label>
                            <span class="text-[9px] font-bold uppercase tracking-tighter" style="color: var(--highlight-color)">{{ 'task.modal.hints.required'|trans }}</span>
                         </div>
                         <input type="text" name="title" required placeholder="{{ 'task.modal.placeholders.title'|trans }}"
                                class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-lg font-bold transition-all outline-none shadow-sm focus:border-[var(--highlight-color)]">
                         </div>

                         {# Description #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="description">
                         <div class="flex items-center justify-between ml-1">
                            <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.description'|trans }}</label>
                            <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                         </div>
                         <textarea name="description" rows="4" placeholder="{{ 'task.modal.placeholders.description'|trans }}"
                                   class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-sm transition-all outline-none shadow-sm resize-none focus:border-[var(--highlight-color)]"></textarea>
                         </div>

                         <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         {# Status #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="status">
                             <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'task.modal.fields.status'|trans }}</label>
                             <div class="relative">
                                <select name="status" data-action="change->task-modal#toggleStatusMessage" 
                                        class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-sm font-bold transition-all outline-none shadow-sm appearance-none cursor-pointer focus:border-[var(--highlight-color)]">
                                    <option value="TODO">{{ 'organ.show.todo'|trans }}</option>
                                    <option value="IN_PROGRESS">{{ 'organ.show.in_progress'|trans }}</option>
                                    <option value="WAITING">{{ 'organ.show.waiting'|trans }}</option>
                                    <option value="DONE">{{ 'organ.show.done'|trans }}</option>
                                    <option value="CANCELED">{{ 'organ.show.canceled'|trans }}</option>
                                </select>
                                <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                             </div>
                         </div>

                         {# Priority #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="priority">
                             <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'task.modal.fields.priority'|trans }}</label>
                             <input type="number" name="priority" min="1" max="10"
                                    class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-sm font-bold transition-all outline-none shadow-sm focus:border-[var(--highlight-color)]">
                         </div>
                         </div>

                         {# Status Message (Conditional) #}
                         <div class="hidden space-y-2 transition-all duration-300" data-task-modal-target="statusMessageContainer">
                         <div class="flex items-center justify-between ml-1">
                            <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.status_message'|trans }}</label>
                            <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                         </div>
                         <textarea name="statusMessage" rows="2" placeholder="{{ 'task.modal.placeholders.status_message'|trans }}"
                                   class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-sm transition-all outline-none shadow-sm resize-none focus:border-[var(--highlight-color)]"></textarea>
                         </div>

                         <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                         {# Dates #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="startDate">
                             <div class="flex items-center justify-between ml-1">
                                <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.start_date'|trans }}</label>
                                <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                             </div>
                             <input type="datetime-local" name="startDate"
                                    class="w-full px-5 py-3 bg-white border border-gray-100 rounded-xl text-sm font-bold transition-all outline-none shadow-sm focus:border-[var(--highlight-color)]">
                         </div>
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="expiresAt">
                             <div class="flex items-center justify-between ml-1">
                                <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.expires_at'|trans }}</label>
                                <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                             </div>
                             <input type="datetime-local" name="expiresAt"
                                    class="w-full px-5 py-3 bg-white border border-gray-100 rounded-xl text-sm font-bold transition-all outline-none shadow-sm focus:border-[var(--highlight-color)]">
                         </div>
                         {# Estimates #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="estimatedHours">
                             <div class="flex items-center justify-between ml-1">
                                <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.estimated_hours'|trans }}</label>
                                <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                             </div>
                             <input type="number" step="0.5" name="estimatedHours" placeholder="0.0"
                                    class="w-full px-5 py-3 bg-white border border-gray-100 rounded-xl text-sm font-bold transition-all outline-none shadow-sm focus:border-[var(--highlight-color)]">
                         </div>
                         </div>

                         {# Manager #}
                         <div class="space-y-2" data-task-modal-target="fieldContainer" data-field="manager">
                         <div class="flex items-center justify-between ml-1">
                            <label class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'task.modal.fields.manager'|trans }}</label>
                            <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter">{{ 'task.modal.hints.optional'|trans }}</span>
                         </div>
                         <div class="relative">
                            <select name="managerUuid" data-task-modal-target="managerSelect" 
                                    class="w-full px-6 py-4 bg-white border border-gray-100 rounded-2xl text-sm font-bold transition-all outline-none shadow-sm appearance-none cursor-pointer focus:border-[var(--highlight-color)]">
                                <option value="">Non assigné</option>
                            </select>
                            <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                         </div>
                         </div>                     </form>

                     {# --- SUB-RESOURCES --- #}
                     <div data-task-modal-target="subResources" class="hidden space-y-12">
                         {# Assignees #}
                         <div class="space-y-4" data-task-modal-target="section" data-section="assignees">
                             <div class="flex items-center justify-between">
                                 <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                                     {{ 'task.modal.fields.assignees'|trans }}
                                 </h3>
                                 <div class="relative" data-task-modal-target="assigneeAddContainer">
                                     <button data-action="click->task-modal#toggleUserPicker" class="text-[10px] font-black uppercase tracking-widest text-highlight hover:opacity-70 transition-opacity cursor-pointer">+ Ajouter</button>
                                     <div data-task-modal-target="userPicker" class="hidden absolute right-0 mt-2 w-64 bg-white border border-gray-100 shadow-2xl rounded-2xl p-2 z-20">
                                         <input type="text" data-action="input->task-modal#filterUsers" placeholder="Rechercher..." class="w-full px-3 py-2 text-xs border-b border-gray-50 outline-none mb-1">
                                         <div data-task-modal-target="userList" class="max-h-48 overflow-y-auto custom-scrollbar"></div>
                                     </div>
                                 </div>
                             </div>
                             <div data-task-modal-target="assigneeList" class="flex flex-wrap gap-3"></div>
                         </div>

                         {# Tags #}
                         <div class="space-y-4" data-task-modal-target="section" data-section="tags">
                             <div class="flex items-center justify-between">
                                 <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                     {{ 'task.modal.fields.tags'|trans }}
                                 </h3>
                                 <div class="relative" data-task-modal-target="tagAddContainer">
                                     <button data-action="click->task-modal#toggleTagPicker" class="text-[10px] font-black uppercase tracking-widest text-highlight hover:opacity-70 transition-opacity cursor-pointer">+ Ajouter</button>
                                     <div data-task-modal-target="tagPicker" class="hidden absolute right-0 mt-2 w-64 bg-white border border-gray-100 shadow-2xl rounded-2xl p-2 z-20">
                                         <div data-task-modal-target="projectTagList" class="max-h-48 overflow-y-auto custom-scrollbar flex flex-col gap-1"></div>
                                     </div>
                                 </div>
                             </div>
                             <div data-task-modal-target="taskTagList" class="flex flex-wrap gap-2"></div>
                         </div>

                         {# Links #}
                         <div class="space-y-4" data-task-modal-target="section" data-section="links">
                             <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                                 {{ 'task.modal.fields.links'|trans }}
                             </h3>
                             <div data-task-modal-target="linkList" class="space-y-2"></div>
                             <button data-action="click->task-modal#showLinkForm" data-task-modal-target="linkAddBtn" class="w-full py-3 bg-white border border-dashed border-gray-200 rounded-xl text-xs font-bold text-gray-400 hover:text-gray-600 hover:border-gray-300 transition-all cursor-pointer">
                                 + Ajouter un lien
                             </button>
                             <div data-task-modal-target="linkForm" class="hidden p-4 bg-white border border-gray-100 rounded-2xl space-y-4">
                                 <input type="url" data-task-modal-target="linkUrl" placeholder="URL (https://...)" class="w-full px-4 py-2 text-xs bg-gray-50 rounded-lg outline-none focus:bg-white border border-transparent focus:border-highlight transition-all">
                                 <input type="text" data-task-modal-target="linkDesc" placeholder="Description" class="w-full px-4 py-2 text-xs bg-gray-50 rounded-lg outline-none focus:bg-white border border-transparent focus:border-highlight transition-all">
                                 <div class="flex justify-end gap-2">
                                     <button data-action="click->task-modal#hideLinkForm" class="px-4 py-2 text-[10px] font-black uppercase tracking-widest text-gray-400">Annuler</button>
                                     <button data-action="click->task-modal#addLink" class="px-4 py-2 bg-black text-white text-[10px] font-black uppercase tracking-widest rounded-lg">Enregistrer</button>
                                 </div>
                             </div>
                         </div>

                         {# Dependencies #}
                         <div class="space-y-4" data-task-modal-target="section" data-section="dependencies">
                             <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                 {{ 'task.modal.fields.dependencies'|trans }}
                             </h3>
                             <div data-task-modal-target="dependencyList" class="space-y-2"></div>
                             <div class="relative">
                                 <button data-action="click->task-modal#toggleDependencyPicker" data-task-modal-target="dependencyAddBtn" class="w-full py-3 bg-white border border-gray-100 rounded-xl text-xs font-bold text-gray-400 hover:text-gray-600 transition-all cursor-pointer">+ Ajouter une dépendance</button>
                                 <div data-task-modal-target="dependencyPicker" class="hidden absolute left-0 right-0 mt-2 bg-white border border-gray-100 shadow-2xl rounded-2xl p-2 z-20">
                                     <input type="text" data-action="input->task-modal#filterTasks" placeholder="Rechercher une tâche..." class="w-full px-3 py-2 text-xs border-b border-gray-50 outline-none mb-1">
                                     <div data-task-modal-target="projectTaskList" class="max-h-48 overflow-y-auto custom-scrollbar flex flex-col gap-1"></div>
                                 </div>
                             </div>
                         </div>

                         {# Attachments #}
                         <div class="space-y-4" data-task-modal-target="section" data-section="attachments">
                             <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                 {{ 'task.modal.fields.attachments'|trans }}
                             </h3>
                             <div data-task-modal-target="attachmentList" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

                             {# Upload Progress #}
                             <div data-task-modal-target="uploadProgressContainer" class="hidden p-6 rounded-3xl space-y-3"
                                  style="background-color: var(--highlight-color)1a; border: 1px solid var(--highlight-color)33;">
                                 <div class="flex items-center justify-between">
                                     <div class="flex items-center gap-3 min-w-0">
                                         <div class="w-8 h-8 rounded-xl flex items-center justify-center animate-pulse"
                                              style="background-color: var(--highlight-color); color: white;">
                                             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                                         </div>
                                         <span data-task-modal-target="uploadFileName" class="text-xs font-bold truncate" style="color: var(--highlight-color)">Fichier en cours...</span>
                                     </div>
                                     <span data-task-modal-target="uploadPercentage" class="text-[10px] font-black uppercase tracking-widest" style="color: var(--highlight-color)">0%</span>
                                 </div>
                                 <div class="w-full h-2 rounded-full overflow-hidden" style="background-color: var(--highlight-color)1a;">
                                     <div data-task-modal-target="uploadProgressBar" class="h-full transition-all duration-300 ease-out" 
                                          style="width: 0%; background-color: var(--highlight-color)"></div>
                                 </div>
                             </div>

                             <div class="relative" data-task-modal-target="attachmentAddContainer">
                                 <input type="file" data-action="change->task-modal#uploadFile" class="hidden" id="task-file-input">
                                 <label for="task-file-input" class="w-full py-6 flex flex-col items-center justify-center bg-white border-2 border-dashed border-gray-100 rounded-[2rem] text-gray-400 hover:text-highlight hover:border-highlight/30 hover:bg-highlight/[0.02] transition-all cursor-pointer group">
                                     <svg class="w-8 h-8 mb-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                                     <span class="text-xs font-bold uppercase tracking-widest">Glisser ou cliquer pour envoyer</span>
                                 </label>
                             </div>
                         </div>

                         {# Comments #}
                         <div class="space-y-6" data-task-modal-target="section" data-section="comments">
                             <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                                 Commentaires
                             </h3>
                             
                             <div data-task-modal-target="commentList" class="space-y-6"></div>
                             
                             <div class="p-4 bg-white border border-gray-100 rounded-2xl space-y-4" data-task-modal-target="commentFormContainer">
                                 <textarea data-task-modal-target="commentContent" rows="3" placeholder="Écrire un commentaire..." class="w-full px-4 py-3 bg-gray-50 rounded-xl text-sm outline-none focus:bg-white border border-transparent focus:border-highlight transition-all resize-none shadow-inner"></textarea>
                                 <div class="flex justify-end">
                                     <button data-action="click->task-modal#addComment" class="px-8 py-3 bg-black text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-black/90 active:scale-95 transition-all shadow-lg cursor-pointer">Envoyer</button>
                                 </div>
                             </div>
                         </div>

                         {# Timeline #}
                         <div class="space-y-6" data-section="timeline">
                             <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                 {{ 'task.history.title'|trans }}
                             </h3>
                             <div data-task-modal-target="timelineList" class="space-y-6 pl-4 border-l-2 border-gray-100"></div>
                             
                             <div class="flex justify-center">
                                 <button data-action="click->task-modal#loadMoreTimeline" 
                                         data-task-modal-target="loadMoreTimelineBtn"
                                         class="px-6 py-2 bg-white border border-gray-100 rounded-xl text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-black hover:border-gray-200 transition-all shadow-sm cursor-pointer hidden">
                                     {{ 'task.history.load_more'|trans }}
                                 </button>
                             </div>
                         </div>

                         {# Trash / Restoration Section #}
                         <div class="pt-12 border-t border-gray-100 space-y-6" data-task-modal-target="trashSection">
                             <div class="flex items-center justify-between">
                                 <h3 class="text-xs font-black uppercase tracking-widest text-gray-300 flex items-center gap-2">
                                     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                     Corbeille de la tâche
                                 </h3>
                                 <button data-action="click->task-modal#toggleTrash" class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-highlight transition-colors cursor-pointer">
                                     Afficher / Masquer
                                 </button>
                             </div>

                             <div data-task-modal-target="trashContent" class="hidden space-y-8 animate-in fade-in slide-in-from-top-2 duration-300">
                                 {# Deleted Attachments #}
                                 <div class="space-y-4">
                                     <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Pièces jointes supprimées</p>
                                     <div data-task-modal-target="deletedAttachmentList" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                         {# JS Rendered #}
                                     </div>
                                 </div>

                                 {# Deleted Links #}
                                 <div class="space-y-4">
                                     <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Liens supprimés</p>
                                     <div data-task-modal-target="deletedLinkList" class="space-y-2">
                                         {# JS Rendered #}
                                     </div>
                                 </div>

                                 {# Deleted Comments #}
                                 <div class="space-y-4">
                                     <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Commentaires supprimés</p>
                                     <div data-task-modal-target="deletedCommentList" class="space-y-4">
                                         {# JS Rendered #}
                                     </div>
                                 </div>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>
        </div>

        {# Sticky Footer #}
        <footer class="p-6 bg-white border-t border-gray-100 flex justify-end shrink-0 z-20">
            <button type="button" data-action="click->task-modal#save" data-task-modal-target="submitBtn" class="px-10 py-4 bg-black text-white font-black uppercase tracking-widest text-xs rounded-2xl hover:bg-black/90 transition-all shadow-lg active:scale-95 flex items-center gap-2 cursor-pointer">
                <span data-task-modal-target="submitBtnText">{{ 'task.modal.buttons.create'|trans }}</span>
            </button>
        </footer>
    </div>

    {# In-App Confirmation Modal #}
    <div data-task-modal-target="confirmModal" 
         class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 animate-in fade-in duration-200">
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" data-action="click->task-modal#cancelConfirm"></div>
        <div class="relative bg-white rounded-[2.5rem] shadow-2xl max-w-sm w-full p-8 space-y-6 animate-in zoom-in-95 duration-200">
            <div class="w-16 h-16 bg-rose-50 rounded-2xl flex items-center justify-center text-rose-500 mx-auto">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            
            <div class="text-center space-y-2">
                <h3 data-task-modal-target="confirmTitle" class="text-xl font-bold text-gray-900">Confirmation</h3>
                <p data-task-modal-target="confirmMessage" class="text-sm text-gray-500 leading-relaxed">Voulez-vous vraiment effectuer cette action ?</p>
            </div>

            <div class="flex flex-col gap-3 pt-2">
                <button type="button" data-action="click->task-modal#executeConfirm" 
                        class="w-full py-4 bg-black text-white font-black uppercase tracking-widest text-[10px] rounded-2xl hover:bg-gray-900 transition-all shadow-lg active:scale-95 cursor-pointer">
                    Confirmer
                </button>
                <button type="button" data-action="click->task-modal#cancelConfirm" 
                        class="w-full py-4 bg-white border border-gray-100 text-gray-400 font-black uppercase tracking-widest text-[10px] rounded-2xl hover:bg-gray-50 transition-all cursor-pointer">
                    Annuler
                </button>
            </div>
        </div>
    </div>
</div>