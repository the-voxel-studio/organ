<footer class="bg-black text-white py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-10 border-b border-gray-800 pb-16">
            <!-- Brand -->
            <div class="flex items-center gap-3">
                <twig:DynamicLogo id="nav-logo" size="48px" />
                <span class="text-2xl font-extrabold tracking-tight">Organ</span>
            </div>

            <!-- Links -->
            <div class="flex flex-wrap justify-center gap-8">
                <a href="{{ path('app_home') }}" class="text-gray-400 hover:text-white transition-colors">{{ 'footer.link_about'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_login')}}" class="text-gray-400 hover:text-white transition-colors">{{ 'footer.link_login'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_register') }}" class="text-gray-400 hover:text-white transition-colors font-bold text-bubblegum">{{ 'footer.link_register'|trans({}, 'landing') }}</a>
            </div>
        </div>

        <div class="pt-10 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-gray-500">
            <!-- Privacy Mention -->
            <div class="flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
                <p>{{ 'footer.rights'|trans({}, 'landing') }}</p>
                <span class="hidden md:inline text-gray-800">|</span>
                <p class="text-gray-400">{{ 'footer.privacy_p1'|trans({}, 'landing') }}</p>
            </div>

            <!-- Legal Links -->
            <div class="flex gap-6">
                <a href="{{ path('app_legal_notice') }}" class="hover:text-white transition-colors">{{ 'footer.link_legal'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_terms') }}" class="hover:text-white transition-colors">{{ 'footer.link_terms'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_privacy_policy') }}" class="hover:text-white transition-colors underline decoration-bubblegum decoration-2 underline-offset-4">{{ 'footer.link_privacy'|trans({}, 'landing') }}</a>
            </div>
        </div>
    </div>
</footer>
