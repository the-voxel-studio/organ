<twig:Navbar
	brand_url="{{ path('app_dashboard') }}">

	{# --- ACTIONS DESKTOP --- #}
	<twig:block name="desktop_actions">
		<div class="relative" data-controller="notifications" data-notifications-api-url-value="http://localhost:8001/api/notifications" data-notifications-subscribe-url-value="http://localhost:8001/api/notifications/subscribe">

			<button type="button" data-action="click->notifications#toggle" class="relative p-2 text-gray-400 hover:text-bubblegum focus:outline-none focus:ring-2 focus:ring-bubblegum/20 rounded-full transition-colors group">
				<span class="sr-only">View notifications</span>
				<svg viewbox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="none" class="w-8 cursor-pointer transition-transform group-hover:scale-110">
					<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
					<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
					<g id="SVGRepo_iconCarrier">
						<title>/svg/ic-notifications</title>
						<desc>Created with Sketch.</desc>
						<defs></defs>
						<g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
							<g id="ic-notifications" fill="#4A4A4A">
								<path d="M17.9559465,17 L16.8572173,9.21455489 C16.5341878,6.92561193 14.3163933,5 12,5 C9.68662535,5 7.4656614,6.92648519 7.14273575,9.21456958 L6.04394973,17 L17.9559465,17 Z M5.16236174,8.93507221 C5.62497658,5.65722234 8.69303423,3 12,3 C15.3137085,3 18.3754003,5.66003534 18.8375934,8.93507221 L19.978875,17.0220385 C20.1330409,18.1144365 19.3700367,19 18.2657828,19 L5.73409618,19 C4.63381562,19 3.86648583,18.1169798 4.02101887,17.0220385 L5.16236174,8.93507221 Z M15,20 C15,21.6568542 13.6568542,23 12,23 C10.3431458,23 9,21.6568542 9,20 L10.5,20 C10.5,20.8284271 11.1715729,21.5 12,21.5 C12.8284271,21.5 13.5,20.8284271 13.5,20 L15,20 Z" id="Rectangle-3" fill-rule="nonzero"></path>
								<circle id="Oval-2" cx="12" cy="3" r="2"></circle>
							</g>
						</g>
					</g>
				</svg>
				<span data-notifications-target="badge" class="absolute top-1 right-1 hidden flex items-center justify-center min-w-[18px] h-[18px] px-1 py-0.5 text-[10px] font-bold leading-none text-white bg-bubblegum rounded-full border-2 border-white">0</span>
			</button>

			{# --- DROPDOWN MENU --- #}
			<div data-notifications-target="menu" class="hidden absolute right-0 mt-3 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 py-1 z-50 overflow-hidden transform origin-top-right transition-all duration-200">
				<div class="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
					<h3 class="text-sm font-bold text-gray-900">Notifications</h3>
					<button type="button" data-action="click->notifications#markAllAsRead" class="text-xs text-bubblegum hover:text-bubblegum/80 font-bold uppercase tracking-wider">Tout lire</button>
				</div>

				<div
					data-notifications-target="list" class="max-h-[380px] overflow-y-auto px-1 space-y-1 bg-gray-50/30">
					{# Liste dynamique injectée par JS #}
				</div>

				<div data-notifications-target="emptyState" class="hidden py-12 text-center px-6">
					<div class="mb-4 text-gray-200">
						<svg class="h-14 w-14 mx-auto" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.143 17.082a23.848 23.848 0 0 0 5.454-1.31a8.967 8.967 0 0 1-2.312-6.022c0-4.746-3.72-8.67-8.247-8.67c-4.527 0-8.247 3.924-8.247 8.67c0 2.108-.707 4.056-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
						</svg>
					</div>
					<p class="text-base font-semibold text-gray-800">Tout est calme</p>
					<p class="text-sm text-gray-500 mt-1">Vous n'avez aucune nouvelle notification pour le moment.</p>
				</div>

				<div class="px-4 py-2 border-t border-gray-100 bg-white text-center">
					<button type="button" data-notifications-target="loadMoreBtn" data-action="click->notifications#loadMore" class="hidden w-full py-2 text-[10px] font-black uppercase tracking-widest text-black/40 hover:text-bubblegum hover:bg-gray-50 rounded-lg transition-all">
						{{ 'sidebar.load_more_notifications'|trans|default('Charger plus de notifications') }}
					</button>
				</div>
			</div>
		</div>
	</twig:block>

	{# --- ACTIONS MOBILE --- #}
	<twig:block name="mobile_actions">
		<div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100" data-controller="notifications" data-notifications-api-url-value="http://localhost:8001/api/notifications" data-notifications-subscribe-url-value="http://localhost:8001/api/notifications/subscribe">
			<div class="flex items-center gap-3">
				<div class="relative">
					<svg class="h-6 w-6 text-gray-500" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31a8.967 8.967 0 0 1-2.312-6.022c0-4.746-3.72-8.67-8.247-8.67c-4.527 0-8.247 3.924-8.247 8.67c0 2.108-.707 4.056-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
					</svg>
					<span data-notifications-target="badge" class="absolute -top-1 -right-1 hidden flex items-center justify-center min-w-[16px] h-[16px] px-1 text-[9px] font-bold leading-none text-white bg-bubblegum rounded-full">0</span>
				</div>
				<span class="text-sm font-semibold text-gray-700">Notifications</span>
			</div>
			<button type="button" data-action="click->notifications#toggle" class="text-xs font-bold text-bubblegum px-3 py-1.5 bg-bubblegum/10 rounded-lg hover:bg-bubblegum/20 transition-colors uppercase tracking-wider">
				Gérer
			</button>

			{# --- MOBILE MENU --- #}
			<div data-notifications-target="menu" class="hidden fixed inset-0 z-[110] bg-white flex flex-col pt-16">
				<div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
					<h3 class="text-lg font-bold text-gray-900">Vos Notifications</h3>
					<button type="button" data-action="click->notifications#toggle" class="p-2 text-gray-400">
						<svg class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
						</svg>
					</button>
				</div>
				<div data-notifications-target="list" class="flex-grow overflow-y-auto"></div>
				
				<div class="p-4 border-t border-gray-100 bg-white">
					<button type="button" data-notifications-target="loadMoreBtn" data-action="click->notifications#loadMore" class="hidden w-full py-4 text-xs font-black uppercase tracking-widest text-bubblegum bg-bubblegum/5 rounded-xl transition-all">
						{{ 'sidebar.load_more_notifications'|trans|default('Charger plus de notifications') }}
					</button>
				</div>

				<div data-notifications-target="emptyState" class="hidden flex-grow flex flex-col items-center justify-center px-10 text-center">
					<div class="mb-6 text-gray-200">
						<svg class="h-20 w-20 mx-auto" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.143 17.082a23.848 23.848 0 0 0 5.454-1.31a8.967 8.967 0 0 1-2.312-6.022c0-4.746-3.72-8.67-8.247-8.67c-4.527 0-8.247 3.924-8.247 8.67c0 2.108-.707 4.056-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
						</svg>
					</div>
					<p class="text-xl font-bold text-gray-900">Aucune notification</p>
					<p class="text-gray-500 mt-2">Nous vous tiendrons au courant dès que quelque chose de nouveau arrivera !</p>
				</div>
			</div>
		</div>
	</twig:block>

</twig:Navbar>
