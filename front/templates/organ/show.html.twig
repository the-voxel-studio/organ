{% extends "layouts/logged/sidebar_layout.html.twig" %}

{% block title %}{{ organ.title }} - {{ project.title }}{% endblock %}

{% block content %}
{% set project_color = project.color|default('#FF7DD4') %}
{% set highlight_color = organ.highlightColor|default('#FF7DD4') %}

<style>
    /* Custom Stylized Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.03);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--highlight-color);
        border-radius: 10px;
        transition: all 0.2s ease;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: var(--highlight-color);
        filter: brightness(0.9);
    }
    /* Firefox */
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: var(--highlight-color) transparent;
    }

    /* Hide native scrollbar but keep functionality */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<div class="min-h-screen relative" 
     data-controller="organ-view task-modal organ-links" 
     data-organ-view-project-uuid-value="{{ project.uuid }}"
     data-organ-view-organ-uuid-value="{{ organ.uuid }}"
     data-organ-view-api-url-value="/api"
     data-organ-view-current-user-uuid-value="{{ app.user.uuid }}"
     data-organ-links-project-uuid-value="{{ project.uuid }}"
     data-organ-links-organ-uuid-value="{{ organ.uuid }}"
     data-organ-links-can-manage-value="{{ ('ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions) ? 'true' : 'false' }}"
     data-task-modal-project-uuid-value="{{ project.uuid }}"
     data-task-modal-organ-uuid-value="{{ organ.uuid }}"
     data-task-modal-api-url-value="/api"
     data-task-modal-current-user-uuid-value="{{ app.user.uuid }}"
     style="--project-color: {{ project_color }}; --highlight-color: {{ highlight_color }}; --highlight: {{ highlight_color }};">    
    {# Background Glow #}
    <div class="fixed top-0 right-0 w-[600px] h-[600px] rounded-full opacity-[0.05] pointer-events-none blur-[120px] -z-10" 
         style="background-color: var(--highlight-color)"></div>

    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        {# --- HEADER --- #}
        <header class="flex flex-col gap-12 mb-12">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-6">
                    {# Icon #}
                    <div class="w-16 h-16 bg-white rounded-2xl shadow-sm border-2 flex items-center justify-center overflow-hidden shrink-0"
                         style="border-color: var(--highlight-color);">
                        {% if organ.iconData is empty %}
                            <div class="w-full h-full" style="background-color: var(--highlight-color)"></div>
                        {% else %}
                            {% if organ.iconType == 'EMOJI' %}
                                <span class="text-3xl">{{ organ.iconData }}</span>
                            {% elseif organ.iconType == 'SVG' %}
                                <div class="w-8 h-8 flex items-center justify-center">{{ organ.iconData|raw }}</div>
                            {% elseif organ.iconType == 'BLOB' %}
                                <img src="{{ organ.iconData }}" alt="{{ organ.title }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full" style="background-color: var(--highlight-color)"></div>
                            {% endif %}
                        {% endif %}
                    </div>

                    {# Title & Description #}
                    <div>
                        <h1 class="text-3xl font-black text-black mb-1">{{ organ.title }}</h1>
                        <div class="flex items-center gap-3">
                            <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-lg" 
                                  style="background-color: var(--project-color)1a; color: var(--project-color);">
                                {{ project.title }}
                            </span>
                            {% if organ.description %}
                                <p class="text-xs text-gray-400 font-medium italic leading-relaxed">{{ organ.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Actions (Right) #}
                <div class="flex items-center gap-3">

                    {# Settings Button #}
                    {% if 'ORGAN_EDIT' in permissions or 'ORGAN_MANAGE_MEMBERS' in permissions or 'ORGAN_MANAGE_ROLES' in permissions or 'ALL' in permissions %}
                        <a href="{{ path('app_organ_edit', {projectUuid: project.uuid, organUuid: organ.uuid}) }}" class="px-5 py-3 bg-black text-white font-bold rounded-2xl transition-all hover:bg-black/90 active:scale-95 shadow-lg flex items-center gap-2 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-white">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
                            </svg>
                            {{ 'project.show.settings'|trans }}
                        </a>
                    {% endif %}

                </div>
            </div>

            {# --- ACTION BAR --- #}
            <div class="flex items-center justify-between bg-white/50 backdrop-blur-sm p-2 rounded-3xl border border-gray-100/50 shadow-sm">
                <div class="flex items-center gap-4">
                    {# View Toggle Group #}
                    <div class="flex p-1 bg-gray-100/80 rounded-2xl">
                        <button data-organ-view-target="kanbanBtn" 
                                data-action="click->organ-view#toggleView" 
                                data-view="kanban"
                                class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer text-white shadow-sm"
                                style="background-color: var(--highlight-color)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 10V7"></path></svg>
                            {{ 'organ.show.kanban'|trans }}
                        </button>
                        <button data-organ-view-target="listBtn" 
                                data-action="click->organ-view#toggleView" 
                                data-view="list"
                                class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer text-gray-500 hover:text-gray-900">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                            {{ 'organ.show.list'|trans }}
                        </button>
                    </div>
                    {# Filter Button & Menu #}
                    <div class="relative">
                        <button data-action="click->organ-view#toggleFilterMenu"
                                class="px-5 py-3 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition-all shadow-sm cursor-pointer group flex items-center gap-2">
                            <svg class="w-4 h-4 text-gray-400 group-hover:text-[var(--highlight-color)] transition-colors" style="--tw-text-opacity: 1;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                            {{ 'organ.show.filter'|trans }}
                        </button>

                        {# Floating Filter Menu #}
                        <div data-organ-view-target="filterMenu" 
                             class="hidden absolute right-0 mt-3 w-72 bg-white rounded-[2rem] shadow-2xl border border-gray-100 p-6 z-50 animate-in fade-in slide-in-from-top-2 duration-200">
                            <div class="space-y-6">
                                {# Sorting #}
                                <div>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-4 ml-1">{{ 'organ.show.sort_by'|trans }}</p>
                                    <div class="grid grid-cols-1 gap-2">
                                        <button data-action="click->organ-view#setSort" data-sort="priority" class="w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold hover:bg-gray-50 transition-colors flex items-center justify-between group/item">
                                            {{ 'organ.show.sort_priority'|trans }}
                                            <span data-organ-view-target="sortIndicator" data-sort="priority" class="hidden text-[var(--highlight-color)] transition-transform duration-200">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                                            </span>
                                        </button>
                                        <button data-action="click->organ-view#setSort" data-sort="date" class="w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold hover:bg-gray-50 transition-colors flex items-center justify-between group/item">
                                            {{ 'organ.show.sort_date'|trans }}
                                            <span data-organ-view-target="sortIndicator" data-sort="date" class="hidden text-[var(--highlight-color)] transition-transform duration-200">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                                            </span>
                                        </button>
                                    </div>
                                </div>

                                {# Filtering #}
                                <div>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-4 ml-1">{{ 'organ.show.filter_by'|trans }}</p>
                                    <div class="space-y-3">
                                        <label class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-50 cursor-pointer transition-colors group">
                                            <div class="relative flex items-center">
                                                <input type="checkbox" data-action="change->organ-view#applyFilters" data-filter="me" class="peer h-5 w-5 cursor-pointer appearance-none rounded-lg border-2 border-gray-200 transition-all checked:border-[var(--highlight-color)] checked:bg-[var(--highlight-color)]">
                                                <svg class="absolute left-1 top-1 h-3 w-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                                            </div>
                                            <span class="text-xs font-bold text-gray-600 group-hover:text-black">{{ 'organ.show.filter_me'|trans }}</span>
                                        </label>

                                        <div class="pt-2">
                                            <p class="text-[9px] font-bold text-gray-300 uppercase tracking-tight mb-2 ml-4">{{ 'organ.show.filter_priority_min'|trans }}</p>
                                            <div class="flex px-4 gap-1">
                                                {% for p in 1..5 %}
                                                    <button data-action="click->organ-view#setPriorityFilter" data-priority="{{ p }}" class="flex-1 py-2 rounded-lg text-[10px] font-black border-2 border-gray-100 hover:border-gray-200 transition-all" data-organ-view-target="priorityFilter">
                                                        {{ p }}
                                                    </button>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        <div class="pt-2">
                                            <p class="text-[9px] font-bold text-gray-300 uppercase tracking-tight mb-2 ml-4">{{ 'organ.show.table.status'|trans }}</p>
                                            <div class="flex flex-wrap px-4 gap-2">
                                                {% set statuses = [
                                                    {'id': 'TODO', 'label': 'organ.show.todo'|trans},
                                                    {'id': 'IN_PROGRESS', 'label': 'organ.show.in_progress'|trans},
                                                    {'id': 'WAITING', 'label': 'organ.show.waiting'|trans},
                                                    {'id': 'DONE', 'label': 'organ.show.done'|trans},
                                                    {'id': 'CANCELED', 'label': 'organ.show.canceled'|trans}
                                                ] %}
                                                {% for s in statuses %}
                                                    <button data-action="click->organ-view#toggleStatusFilter" 
                                                            data-status="{{ s.id }}" 
                                                            data-organ-view-target="statusFilter"
                                                            class="px-3 py-1.5 rounded-lg text-[9px] font-black border-2 border-gray-100 hover:border-gray-200 transition-all uppercase tracking-wider">
                                                        {{ s.label }}
                                                    </button>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {# Reset #}
                                <div class="pt-4 border-t border-gray-50">
                                    <button data-action="click->organ-view#resetFilters" class="w-full py-3 rounded-2xl bg-gray-50 text-[10px] font-black uppercase tracking-widest text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-all">
                                        {{ 'organ.show.reset_filters'|trans }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Links Toggle Button #}
                    <button data-action="click->organ-links#togglePanel"
                            class="px-5 py-3 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition-all shadow-sm cursor-pointer group flex items-center gap-2">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[var(--highlight-color)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        {{ 'organ.show.links'|trans }}
                    </button>

                    {# Trash Button #}
                    {% if 'ORGAN_EDIT' in permissions or 'ORGAN_MANAGE_ROLES' in permissions or 'TASK_DELETE_OWN' in permissions or 'TASK_DELETE_ALL' in permissions or 'ALL' in permissions %}
                        <a href="{{ path('app_organ_trash', {projectUuid: project.uuid, organUuid: organ.uuid}) }}" 
                           class="flex items-center gap-2 px-5 py-3 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-red-50 hover:text-red-600 hover:border-red-100 transition-all shadow-sm cursor-pointer group flex items-center gap-2">
                            <svg class="w-4 h-4 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            {{ 'organ.show.trash'|trans }}
                        </a>
                    {% endif %}
                </div>

                <div class="flex items-center gap-3">
                    {# Add Task Button #}
                    {% if 'TASK_CREATE' in permissions or 'ALL' in permissions %}
                        <button data-action="click->task-modal#openForCreate" 
                                class="px-6 py-3 bg-black text-white font-bold rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-lg flex items-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            {{ 'organ.show.add_task'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>


            {# --- LINKS PANEL --- #}
            <div data-organ-links-target="panel" class="hidden animate-in fade-in slide-in-from-top-4 duration-300">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-lg font-bold text-black flex items-center gap-3">
                        <div class="p-2 rounded-xl" style="background-color: var(--highlight-color)1a; color: var(--highlight-color)">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        </div>
                        {{ 'organ.show.links_title'|trans }}
                    </h3>
                    
                    {% if 'ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions %}
                        <button data-action="click->organ-links#toggleForm" 
                                class="px-4 py-2 bg-white border border-gray-100 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-gray-50 transition-all shadow-sm cursor-pointer"
                                style="color: var(--highlight-color)">
                            {{ 'organ.show.add_link_btn'|trans }}
                        </button>
                    {% endif %}
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
                    <div data-organ-links-target="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {# Stimulus Rendered #}
                    </div>

                    {% if 'ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions %}
                        <form data-organ-links-target="form" data-action="submit->organ-links#saveLink" class="mt-8 hidden p-6 bg-gray-50/50 rounded-2xl border border-gray-100 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-2">
                                    <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'organ.show.url_label'|trans }}</label>
                                    <input type="url" data-organ-links-target="urlInput" required placeholder="{{ 'organ.show.url_placeholder'|trans }}" 
                                           class="w-full px-5 py-3 bg-white border border-gray-100 focus:border-highlight rounded-xl text-sm transition-all outline-none shadow-sm"
                                           onfocus="this.style.borderColor= 'var(--highlight-color)'"
                                           onblur="this.style.borderColor='#f3f4f6'">
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'organ.show.description_label'|trans }}</label>
                                    <input type="text" data-organ-links-target="descriptionInput" placeholder="{{ 'organ.show.description_placeholder_alt'|trans }}" 
                                           class="w-full px-5 py-3 bg-white border border-gray-100 focus:border-highlight rounded-xl text-sm transition-all outline-none shadow-sm"
                                           onfocus="this.style.borderColor= 'var(--highlight-color)'"
                                           onblur="this.style.borderColor='#f3f4f6'">
                                </div>
                            </div>
                            <div class="flex justify-end gap-3 pt-4">
                                <button type="button" data-action="click->organ-links#toggleForm" class="px-6 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 transition-colors cursor-pointer">
                                    {{ 'organ.create.form.actions.cancel'|trans }}
                                </button>
                                <button type="submit" data-organ-links-target="submitBtn" 
                                        class="px-8 py-3 bg-black text-white font-bold rounded-xl hover:bg-black/90 transition-all shadow-lg active:scale-95 flex items-center gap-2 cursor-pointer">
                                    <div data-organ-links-target="spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                    {{ 'organ.show.save_link'|trans }}
                                </button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </header>

        {# --- TOP SCROLL SYNC (Kanban only) --- #}
        <div data-organ-view-target="topScrollContainer" class="hidden overflow-x-auto h-2 mb-12 custom-scrollbar">
            <div data-organ-view-target="topScrollThumb" class="h-1"></div>
        </div>

        {# --- VIEWS --- #}
        <div data-organ-view-target="kanbanView" class="overflow-x-auto pb-12 custom-scrollbar">
            <div class="flex gap-8 min-w-max pr-8">
                {# TODO Column #}
                <div data-organ-view-target="statusColumn" data-status="TODO" class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                            {{ 'organ.show.todo'|trans }}
                        </h5>
                        <span data-organ-view-target="todoCount" class="text-[10px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div data-organ-view-target="todoCol" data-status="TODO" class="min-h-[600px] rounded-[2.5rem] p-6 flex flex-col gap-4 transition-all shadow-inner" 
                         style="background: linear-gradient(180deg, var(--highlight-color)14 0%, var(--highlight-color)05 100%); border: none;"></div>
                </div>

                {# IN PROGRESS Column #}
                <div data-organ-view-target="statusColumn" data-status="IN_PROGRESS" class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full" style="background-color: var(--highlight-color)"></span>
                            {{ 'organ.show.in_progress'|trans }}
                        </h5>
                        <span data-organ-view-target="inProgressCount" class="text-[10px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div data-organ-view-target="inProgressCol" data-status="IN_PROGRESS" class="min-h-[600px] rounded-[2.5rem] p-6 flex flex-col gap-4 transition-all shadow-inner" 
                         style="background: linear-gradient(180deg, var(--highlight-color)14 0%, var(--highlight-color)05 100%); border: none;"></div>
                </div>

                {# WAITING Column #}
                <div data-organ-view-target="statusColumn" data-status="WAITING" class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                            {{ 'organ.show.waiting'|trans }}
                        </h5>
                        <span data-organ-view-target="waitingCount" class="text-[10px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div data-organ-view-target="waitingCol" data-status="WAITING" class="min-h-[600px] rounded-[2.5rem] p-6 flex flex-col gap-4 transition-all shadow-inner" 
                         style="background: linear-gradient(180deg, var(--highlight-color)14 0%, var(--highlight-color)05 100%); border: none;"></div>
                </div>

                {# DONE Column #}
                <div data-organ-view-target="statusColumn" data-status="DONE" class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-green-400"></span>
                            {{ 'organ.show.done'|trans }}
                        </h5>
                        <span data-organ-view-target="doneCount" class="text-[10px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div data-organ-view-target="doneCol" data-status="DONE" class="min-h-[600px] rounded-[2.5rem] p-6 flex flex-col gap-4 transition-all shadow-inner" 
                         style="background: linear-gradient(180deg, var(--highlight-color)14 0%, var(--highlight-color)05 100%); border: none;"></div>
                </div>

                {# CANCELED Column #}
                <div data-organ-view-target="statusColumn" data-status="CANCELED" class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                            {{ 'organ.show.canceled'|trans }}
                        </h5>
                        <span data-organ-view-target="canceledCount" class="text-[10px] font-black text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                    </div>
                    <div data-organ-view-target="canceledCol" data-status="CANCELED" class="min-h-[600px] rounded-[2.5rem] p-6 flex flex-col gap-4 transition-all shadow-inner" 
                         style="background: linear-gradient(180deg, var(--highlight-color)14 0%, var(--highlight-color)05 100%); border: none;"></div>
                </div>
            </div>
        </div>

        <div data-organ-view-target="listView" class="hidden">
            <div class="bg-white rounded-[3rem] shadow-sm border border-gray-100 overflow-hidden">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100">
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'organ.show.table.task'|trans }}</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'organ.show.table.status'|trans }}</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'organ.show.table.priority'|trans }}</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'organ.show.table.due_date'|trans }}</th>
                            <th class="px-8 py-5"></th>
                        </tr>
                    </thead>
                    <tbody data-organ-view-target="listBody">
                       {# JS Rendered #}
                    </tbody>
                </table>
            </div>
        </div>

        {# Custom Confirmation Modal for Links #}
        <div data-organ-links-target="confirmModal" 
             class="hidden fixed inset-0 z-[110] flex items-center justify-center p-4 animate-in fade-in duration-200">
            <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" data-action="click->organ-links#closeConfirm"></div>
            <div class="relative bg-white rounded-[2.5rem] shadow-2xl max-w-sm w-full p-8 space-y-6 animate-in zoom-in-95 duration-200">
                <div class="w-16 h-16 bg-rose-50 rounded-2xl flex items-center justify-center text-rose-500 mx-auto">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>

                <div class="text-center space-y-2">
                    <h3 data-organ-links-target="confirmTitle" class="text-xl font-bold text-gray-900">{{ 'generic.confirmation'|trans }}</h3>
                    <p data-organ-links-target="confirmMessage" class="text-sm text-gray-500 leading-relaxed"></p>
                </div>

                <div class="flex flex-col gap-3 pt-2">
                    <button type="button" data-action="click->organ-links#confirmDelete" 
                            class="w-full py-4 bg-black text-white font-black uppercase tracking-widest text-[10px] rounded-2xl hover:bg-gray-900 transition-all shadow-lg active:scale-95 cursor-pointer">
                        {{ 'generic.confirm_delete'|trans }}
                    </button>
                    <button type="button" data-action="click->organ-links#closeConfirm" 
                            class="w-full py-4 bg-white border border-gray-100 text-gray-400 font-black uppercase tracking-widest text-[10px] rounded-2xl hover:bg-gray-50 transition-all cursor-pointer">
                        {{ 'generic.cancel'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </main>

    {% include "components/task_modal.html.twig" %}
</div>
{% endblock %}
