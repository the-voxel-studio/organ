{% extends "layouts/logged/sidebar_layout.html.twig" %}

{% block title %}{{ organ.title }} - {{ project.title }}{% endblock %}

{% block content %}
{% set project_color = project.color|default('#FF7DD4') %}
{% set highlight_color = organ.highlightColor|default('#FF7DD4') %}

<style>
    /* Custom Stylized Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.03);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--highlight-color);
        border-radius: 10px;
        transition: all 0.2s ease;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: var(--highlight-color);
        filter: brightness(0.9);
    }
    /* Firefox */
    .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: var(--highlight-color) transparent;
    }

    /* Hide native scrollbar but keep functionality */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<div class="min-h-screen relative" 
     data-controller="organ-view"
     style="--project-color: {{ project_color }}; --highlight-color: {{ highlight_color }}; --highlight: {{ highlight_color }};">
    
    {# Background Glow #}
    <div class="fixed top-0 right-0 w-[600px] h-[600px] rounded-full opacity-[0.05] pointer-events-none blur-[120px] -z-10" 
         style="background-color: var(--highlight-color)"></div>

    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        {# --- HEADER --- #}
        <header class="flex flex-col gap-8 mb-12">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-6">
                    {# Icon #}
                    <div class="w-16 h-16 bg-white rounded-2xl shadow-sm border-2 flex items-center justify-center overflow-hidden shrink-0"
                         style="border-color: var(--highlight-color);">
                        {% if organ.iconType == 'EMOJI' %}
                            <span class="text-3xl">{{ organ.iconData|default('🚀') }}</span>
                        {% elseif organ.iconType == 'SVG' %}
                            <div class="w-8 h-8 flex items-center justify-center">{{ organ.iconData|raw }}</div>
                        {% elseif organ.iconType == 'BLOB' %}
                            <img src="{{ organ.iconData }}" alt="{{ organ.title }}" class="w-full h-full object-cover">
                        {% else %}
                            <span class="text-3xl">🚀</span>
                        {% endif %}
                    </div>

                    {# Title & Description #}
                    <div>
                        <h1 class="text-3xl font-black text-black mb-1">{{ organ.title }}</h1>
                        <div class="flex items-center gap-3">
                            <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-lg" 
                                  style="background-color: var(--project-color)1a; color: var(--project-color);">
                                {{ project.title }}
                            </span>
                            {% if organ.description %}
                                <p class="text-xs text-gray-400 font-medium italic leading-relaxed">{{ organ.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Actions (Right) #}
                <div class="flex items-center gap-3">
                    {% if 'ORGAN_EDIT' in permissions or 'ORGAN_MANAGE_MEMBERS' in permissions or 'ORGAN_MANAGE_ROLES' in permissions or 'ALL' in permissions %}
                        <a href="{{ path('app_organ_edit', {projectUuid: project.uuid, organUuid: organ.uuid}) }}" class="px-6 py-3 bg-black text-white font-bold rounded-2xl transition-all hover:bg-black/90 active:scale-95 shadow-lg flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
                            </svg>
                            {{ 'project.show.settings'|trans }}
                        </a>
                    {% endif %}
                </div>            </div>

            {# --- ACTION BAR --- #}
            <div class="flex items-center justify-between bg-white/50 backdrop-blur-sm p-2 rounded-3xl border border-gray-100/50 shadow-sm">
                <div class="flex items-center gap-4">
                    {# View Toggle Group #}
                    <div class="flex p-1 bg-gray-100/80 rounded-2xl">
                        <button data-organ-view-target="kanbanBtn" 
                                data-action="click->organ-view#toggleView" 
                                data-view="kanban"
                                class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer text-white shadow-sm"
                                style="background-color: var(--highlight-color)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2m0 10V7"></path></svg>
                            {{ 'organ.show.kanban'|trans }}
                        </button>
                        <button data-organ-view-target="listBtn" 
                                data-action="click->organ-view#toggleView" 
                                data-view="list"
                                class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold transition-all cursor-pointer text-gray-500 hover:text-gray-900">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                            {{ 'organ.show.list'|trans }}
                        </button>
                    </div>

                    {# Links Button #}
                    <button data-action="click->organ-view#toggleLinks"
                            class="flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition-all shadow-sm cursor-pointer group">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[var(--highlight-color)] transition-colors" style="--tw-text-opacity: 1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        {{ 'organ.show.links'|trans }}
                    </button>

                    {# Filter Button #}
                    <button class="flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition-all shadow-sm cursor-pointer group">
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[var(--highlight-color)] transition-colors" style="--tw-text-opacity: 1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                        {{ 'organ.show.filter'|trans }}
                    </button>

                    {# Trash Button #}
                    {% if 'ORGAN_EDIT' in permissions or 'ORGAN_MANAGE_ROLES' in permissions or 'TASK_DELETE_OWN' in permissions or 'TASK_DELETE_ALL' in permissions or 'ALL' in permissions %}
                        <a href="{{ path('app_organ_trash', {projectUuid: project.uuid, organUuid: organ.uuid}) }}" 
                           class="flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-red-50 hover:text-red-600 hover:border-red-100 transition-all shadow-sm cursor-pointer group">
                            <svg class="w-4 h-4 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Corbeille
                        </a>
                    {% endif %}
                    </div>

                <div class="flex items-center gap-3">
                    {% if 'TASK_CREATE' in permissions or 'ALL' in permissions %}
                        <button class="px-6 py-2.5 bg-black text-white font-bold rounded-2xl hover:bg-black/90 transition-all shadow-lg active:scale-95 flex items-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 5v14M5 12h14"></path></svg>
                            {{ 'organ.show.new_task'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </header>

        {# --- LINKS PANEL (Collapse) --- #}
        <section data-organ-view-target="linksPanel" 
                 class="hidden mb-12"
                 data-controller="organ-links"
                 data-organ-links-project-uuid-value="{{ project.uuid }}"
                 data-organ-links-organ-uuid-value="{{ organ.uuid }}"
                 data-organ-links-can-manage-value="{{ ('ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions) ? 'true' : 'false' }}">
            
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-xl font-bold text-black flex items-center gap-3">
                    <div class="p-2 rounded-xl" style="background-color: var(--highlight-color)1a; color: var(--highlight-color)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    </div>
                    {{ 'organ.show.links'|trans }}
                </h2>
                
                {% if 'ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions %}
                    <button data-action="click->organ-links#toggleForm" 
                            class="px-4 py-2 bg-white border border-gray-100 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-gray-50 transition-all shadow-sm cursor-pointer"
                            style="color: var(--highlight-color)">
                        + {{ 'organ.show.add_link'|trans }}
                    </button>
                {% endif %}
            </div>

            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
                <div data-organ-links-target="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {# Stimulus Rendered #}
                </div>

                {% if 'ORGAN_LINK_MANAGE' in permissions or 'ALL' in permissions %}
                    <form data-organ-links-target="form" data-action="submit->organ-links#addLink" class="mt-8 hidden p-6 bg-gray-50/50 rounded-2xl border border-gray-100 space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'organ.show.links'|trans }} (URL)</label>
                                <input type="url" data-organ-links-target="urlInput" required placeholder="{{ 'organ.show.url_placeholder'|trans }}" 
                                       class="w-full px-5 py-3 bg-white border border-gray-100 focus:border-highlight rounded-xl text-sm transition-all outline-none shadow-sm"
                                       onfocus="this.style.borderColor= 'var(--highlight-color)'"
                                       onblur="this.style.borderColor='#f3f4f6'">
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">Description ({{ 'organ.create.form.description.placeholder'|trans }})</label>
                                <input type="text" data-organ-links-target="descriptionInput" placeholder="{{ 'organ.show.description_placeholder'|trans }}" 
                                       class="w-full px-5 py-3 bg-white border border-gray-100 focus:border-highlight rounded-xl text-sm transition-all outline-none shadow-sm"
                                       onfocus="this.style.borderColor= 'var(--highlight-color)'"
                                       onblur="this.style.borderColor='#f3f4f6'">
                            </div>
                        </div>
                        <div class="flex justify-end gap-3 pt-2">
                            <button type="button" data-action="click->organ-links#toggleForm" class="px-5 py-2.5 text-xs font-bold text-gray-500 hover:text-gray-700 transition-colors cursor-pointer">{{ 'organ.create.form.actions.cancel'|trans }}</button>
                            <button type="submit" data-organ-links-target="submitBtn" class="px-8 py-2.5 text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center gap-2 cursor-pointer"
                                    style="background-color: var(--highlight-color); shadow-color: var(--highlight-color)">
                                <span data-organ-links-target="spinner" class="hidden animate-spin">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                </span>
                                {{ 'organ.show.save_link'|trans }}
                            </button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </section>

        {# --- TASKS VIEW --- #}
        {# Top Scrollbar (Synchronized) #}
        <div data-organ-view-target="topScrollContainer" 
             class="overflow-x-auto custom-scrollbar mb-4" 
             style="height: 10px;">
            <div data-organ-view-target="topScrollThumb" style="height: 1px; background-color: transparent;"></div>
        </div>

        <div data-organ-view-target="kanbanView" class="overflow-x-auto pb-8 -mx-4 px-4 hide-scrollbar mt-12">
            <div class="flex gap-8 min-w-max">
                {# TODO Column #}
                <div class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-slate-300"></span>
                            {{ 'organ.show.todo'|trans }}
                        </h5>
                        <span class="text-[10px] font-black text-gray-400 bg-gray-100/50 px-2.5 py-1 rounded-lg border border-gray-100">0</span>
                    </div>
                    <div class="min-h-[600px] bg-gray-50/30 rounded-[2rem] border border-gray-100/50 p-6 flex flex-col gap-4">
                        {# Tasks will be here #}
                        <div class="py-12 text-center">
                            <p class="text-xs text-gray-400 font-medium italic">{{ 'organ.show.no_tasks'|trans }}</p>
                        </div>
                    </div>
                </div>

                {# IN PROGRESS Column #}
                <div class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                            {{ 'organ.show.in_progress'|trans }}
                        </h5>
                        <span class="text-[10px] font-black text-gray-400 bg-gray-100/50 px-2.5 py-1 rounded-lg border border-gray-100">0</span>
                    </div>
                    <div class="min-h-[600px] bg-gray-50/30 rounded-[2rem] border border-gray-100/50 p-6 flex flex-col gap-4"></div>
                </div>

                {# WAITING Column #}
                <div class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                            {{ 'organ.show.waiting'|trans }}
                        </h5>
                        <span class="text-[10px] font-black text-gray-400 bg-gray-100/50 px-2.5 py-1 rounded-lg border border-gray-100">0</span>
                    </div>
                    <div class="min-h-[600px] bg-gray-50/30 rounded-[2rem] border border-gray-100/50 p-6 flex flex-col gap-4"></div>
                </div>

                {# DONE Column #}
                <div class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-green-400"></span>
                            {{ 'organ.show.done'|trans }}
                        </h5>
                        <span class="text-[10px] font-black text-gray-400 bg-gray-100/50 px-2.5 py-1 rounded-lg border border-gray-100">0</span>
                    </div>
                    <div class="min-h-[600px] bg-gray-50/30 rounded-[2rem] border border-gray-100/50 p-6 flex flex-col gap-4"></div>
                </div>

                {# CANCELED Column #}
                <div class="space-y-6 w-[350px]">
                    <div class="flex items-center justify-between px-4">
                        <h5 class="text-[10px] font-black uppercase tracking-widest text-gray-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                            {{ 'organ.show.canceled'|trans }}
                        </h5>
                        <span class="text-[10px] font-black text-gray-400 bg-gray-100/50 px-2.5 py-1 rounded-lg border border-gray-100">0</span>
                    </div>
                    <div class="min-h-[600px] bg-gray-50/30 rounded-[2rem] border border-gray-100/50 p-6 flex flex-col gap-4"></div>
                </div>
            </div>
        </div>

        <div data-organ-view-target="listView" class="hidden">
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100">
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">{{ 'dashboard.tasks.headers.name'|trans }}</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">Statut</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">Priorité</th>
                            <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <tr>
                            <td colspan="4" class="px-8 py-20 text-center text-sm text-gray-400 italic font-medium">
                                {{ 'organ.show.no_tasks'|trans }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
{% endblock %}
