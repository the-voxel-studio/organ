{% extends "layouts/logged/navbar_layout.html.twig" %}

{% block hide_mobile_menu %}true{% endblock %}

{% block title %}
    {{ project is defined ? 'project.edit.title'|trans : 'project.create.title'|trans }}
{% endblock %}

{% block body_attrs %}
{% set is_edit = project is defined %}
     data-controller="project-create"
     data-project-create-api-url-value="/api"
     data-project-create-project-uuid-value="{{ is_edit ? project.uuid : '' }}"
     data-project-create-user-email-value="{{ app.user.email }}"
     data-project-create-user-name-value="{{ app.user.firstName }}"
     data-project-create-initial-members-value="{{ members is defined ? members|json_encode : '[]' }}"
     data-project-create-invitations-value="{{ invitations is defined ? invitations|json_encode : '[]' }}"
     data-project-create-google-client-id-value="{{ googleClientId|default('') }}"
     data-project-create-user-role-value="{{ role|default('MEMBER') }}"
{% endblock %}

{% block content %}
{% set is_edit = project is defined %}
<div class="max-w-4xl mx-auto py-8">
    <div class="mb-8 px-4">
        <a href="{{ is_edit ? path('app_project_show', {uuid: project.uuid}) : path('app_dashboard') }}" class="text-sm font-medium text-gray-500 hover:text-bubblegum transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            {{ is_edit ? 'project.edit.back_to_project'|trans : 'project.create.back_to_dashboard'|trans }}
        </a>
        <h1 class="text-4xl font-bold text-gray-900 mt-4">
            {{ is_edit ? 'project.edit.title'|trans : 'project.create.title'|trans }}
        </h1>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        <div class="space-y-8">
            {# Nom du projet #}
            <div class="space-y-2">
                <label for="name" class="block text-sm font-semibold text-gray-700">{{ 'project.create.form.name.label'|trans }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    </div>
                    <input type="text" id="name" data-project-create-target="name"
                           class="block w-full pl-11 pr-4 py-4 bg-gray-50 border-transparent focus:border-bubblegum focus:bg-white focus:ring-0 rounded-2xl text-gray-900 placeholder-gray-400 transition-all font-medium"
                           placeholder="{{ 'project.create.form.name.placeholder'|trans }}"
                           value="{{ is_edit ? project.title : '' }}">
                </div>
            </div>

            {# Description #}
            <div class="space-y-2">
                <label for="description" class="block text-sm font-semibold text-gray-700">{{ 'project.create.form.description.label'|trans }}</label>
                <textarea id="description" data-project-create-target="description" rows="3"
                          class="block w-full px-4 py-4 bg-gray-50 border-transparent focus:border-bubblegum focus:bg-white focus:ring-0 rounded-2xl text-gray-900 placeholder-gray-400 transition-all font-medium resize-none"
                          placeholder="{{ 'project.create.form.description.placeholder'|trans }}">{{ is_edit ? project.description : '' }}</textarea>
            </div>

            {# Statut (uniquement en édition) #}
            {% if is_edit %}
                <div class="space-y-2">
                    <label for="status" class="block text-sm font-semibold text-gray-700">Statut du projet</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <select id="status" data-project-create-target="status"
                                class="block w-full pl-11 pr-10 py-4 bg-gray-50 border-transparent focus:border-bubblegum focus:bg-white focus:ring-0 rounded-2xl text-gray-900 font-medium appearance-none transition-all">
                            <option value="ACTIVE" {{ project.status == 'ACTIVE' ? 'selected' : '' }}>Actif</option>
                            <option value="ARCHIVED" {{ project.status == 'ARCHIVED' ? 'selected' : '' }}>Archivé</option>
                            <option value="INACTIVE" {{ project.status == 'INACTIVE' ? 'selected' : '' }}>Inactif</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Identité visuelle #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                {# COULEUR #}
                <div class="space-y-4">
                    <label class="block text-sm font-semibold text-gray-700">{{ 'project.create.form.identity.color'|trans }}</label>
                    <div class="flex flex-wrap gap-3 items-center">
                        {% set colors = ['#FF7EB6', '#4ADE80', '#60A5FA', '#FBBF24', '#A78BFA'] %}
                        {% set current_color = is_edit ? project.color : colors[0] %}
                        {% set is_custom = is_edit and (project.color not in colors) %}

                        {% for color in colors %}
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="project_color" value="{{ color }}" class="sr-only peer" data-project-create-target="colorInputs" data-action="change->project-create#handleColorChange" {{ current_color == color ? 'checked' : '' }}>
                                <div class="w-10 h-10 rounded-full border-2 border-transparent peer-checked:border-black transition-all group-hover:scale-110" style="background-color: {{ color }};"></div>
                            </label>
                        {% endfor %}
                        
                        <label class="relative cursor-pointer group">
                            <input type="radio" name="project_color" value="custom" id="customColorRadio" class="sr-only peer" data-project-create-target="colorInputs" data-action="change->project-create#handleColorChange" {{ is_custom ? 'checked' : '' }}>
                            <input type="color" id="customColorPicker" data-project-create-target="customColorPicker" class="sr-only" value="{{ is_custom ? project.color : '#000000' }}" data-action="input->project-create#handleCustomColorInput">
                            <div data-project-create-target="customColorDisplay" data-action="click->project-create#triggerColorPicker"
                                 class="w-10 h-10 rounded-full bg-gray-100 border-2 border-dashed border-gray-300 peer-checked:border-black peer-checked:border-solid flex items-center justify-center text-gray-500 transition-all group-hover:scale-110"
                                 style="{{ is_custom ? 'background-color: ' ~ project.color : '' }}">
                                <svg data-project-create-target="customColorIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ is_custom ? 'hidden' : '' }}"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            </div>
                        </label>
                    </div>
                </div>

                {# ICON #}
                <div class="space-y-4">
                    <label class="block text-sm font-semibold text-gray-700">{{ 'project.create.form.identity.icon'|trans }}</label>
                    
                    <div class="flex flex-wrap gap-2 p-1 bg-gray-50 rounded-xl w-fit">
                        {% set icon_mode = is_edit ? project.iconType : 'BLOB' %}
                        <button type="button" data-action="click->project-create#switchIconMode" data-mode="BLOB" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all {{ icon_mode == 'BLOB' ? 'bg-white shadow-sm text-gray-900' : 'text-gray-500 hover:text-gray-900' }}" data-project-create-target="modeBtn">Image</button>
                        <button type="button" data-action="click->project-create#switchIconMode" data-mode="EMOJI" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all {{ icon_mode == 'EMOJI' ? 'bg-white shadow-sm text-gray-900' : 'text-gray-500 hover:text-gray-900' }}" data-project-create-target="modeBtn">Emoji</button>
                        <button type="button" data-action="click->project-create#switchIconMode" data-mode="SVG" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all {{ icon_mode == 'SVG' ? 'bg-white shadow-sm text-gray-900' : 'text-gray-500 hover:text-gray-900' }}" data-project-create-target="modeBtn">Custom SVG</button>
                    </div>

                    {# Image Upload #}
                    <div data-project-create-target="iconSection" data-mode="BLOB" class="{{ icon_mode == 'BLOB' ? '' : 'hidden' }}">
                        <label class="flex items-center justify-center w-32 h-32 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl cursor-pointer hover:border-bubblegum transition-all group overflow-hidden">
                            <input type="file" data-project-create-target="imageInput" class="sr-only" accept="image/*" data-action="change->project-create#handleImagePreview">
                            <div data-project-create-target="imagePlaceholder" class="text-center {{ (is_edit and icon_mode == 'BLOB' and project.iconData is not empty) ? 'hidden' : '' }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-8 w-8 text-gray-400 group-hover:text-bubblegum" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                                <span class="mt-2 block text-xs font-semibold text-gray-400 group-hover:text-bubblegum">Upload</span>
                            </div>
                            <img data-project-create-target="imagePreview" src="{{ (is_edit and icon_mode == 'BLOB' and project.iconData is not empty) ? project.iconData : '' }}" class="{{ (is_edit and icon_mode == 'BLOB' and project.iconData is not empty) ? '' : 'hidden' }} w-full h-full object-cover">
                        </label>
                    </div>

                    {# Emoji Input #}
                    <div data-project-create-target="iconSection" data-mode="EMOJI" class="{{ icon_mode == 'EMOJI' ? '' : 'hidden' }}">
                        <div class="flex items-center gap-4">
                            <input type="text" data-project-create-target="emojiInput" data-action="input->project-create#validateEmojiInput"
                                   class="w-16 h-16 text-3xl text-center bg-gray-50 border-2 border-dashed border-gray-200 focus:border-bubblegum focus:bg-white rounded-2xl outline-none transition-all"
                                   placeholder="🚀" maxlength="2" value="{{ (is_edit and icon_mode == 'EMOJI') ? project.iconData : '' }}">
                        </div>
                    </div>

                    {# Custom SVG #}
                    <div data-project-create-target="iconSection" data-mode="SVG" class="{{ (is_edit and icon_mode == 'SVG') ? '' : 'hidden' }} space-y-3">
                        <textarea data-project-create-target="customSvgInput" rows="3"
                                  class="block w-full px-4 py-3 bg-gray-50 border-2 border-dashed border-gray-200 focus:border-bubblegum focus:bg-white rounded-2xl text-xs font-mono transition-all resize-none"
                                  placeholder="<svg ...>...</svg>">{{ (is_edit and icon_mode == 'SVG') ? project.iconData : '' }}</textarea>
                    </div>
                </div>
            </div>

            <hr class="border-gray-100">

            {# Inviter des membres #}
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold text-gray-900">{{ 'project.create.form.members.title'|trans }}</h3>
                    <button type="button" data-action="click->project-create#toggleRoleExplanation" class="text-sm font-medium text-bubblegum hover:underline">
                        {{ 'project.create.form.members.understand_roles'|trans }}
                    </button>
                </div>

                <div data-project-create-target="roleExplanation" class="hidden bg-bubblegum/5 border border-bubblegum/10 rounded-2xl p-6 space-y-3">
                    <p class="text-sm text-gray-700">{{ 'project.create.form.members.roles_explanation.admin'|trans|raw }}</p>
                    <p class="text-sm text-gray-700">{{ 'project.create.form.members.roles_explanation.manager'|trans|raw }}</p>
                    <p class="text-sm text-gray-700">{{ 'project.create.form.members.roles_explanation.member'|trans|raw }}</p>
                    <div class="mt-4 pt-4 border-t border-bubblegum/10">
                        <p class="text-xs font-bold text-bubblegum flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                            {{ 'project.create.form.members.roles_explanation.single_admin_warning'|trans }}
                        </p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="flex-grow relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <input type="email" data-project-create-target="inviteEmail"
                               class="block w-full pl-11 pr-4 py-4 bg-gray-50 border-transparent focus:border-bubblegum focus:bg-white focus:ring-0 rounded-2xl text-gray-900 placeholder-gray-400 transition-all font-medium"
                               placeholder="{{ 'project.create.form.members.email.placeholder'|trans }}">
                    </div>
                    <button type="button" data-action="click->project-create#addInvite"
                            class="px-8 py-4 bg-gray-900 text-white font-bold rounded-2xl hover:bg-gray-800 transition-all active:scale-95">
                        {{ 'project.create.form.members.add'|trans }}
                    </button>
                </div>

                <div class="space-y-4">
                    <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">{{ 'project.create.form.members.added_list'|trans }}</h4>
                    <div data-project-create-target="inviteList" class="space-y-3">
                        {# JS Rendered #}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# --- BYOS: Google Drive (Admin Only) --- #}
    {% if is_edit and role|default('MEMBER') == 'ADMIN' %}
        <div class="mt-12 px-4">
            <div class="bg-blue-50/30 rounded-3xl border border-blue-100 p-8 space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-xl font-bold text-blue-600 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            Extension Google Drive (BYOS)
                        </h3>
                        <p class="text-sm text-blue-500/70 font-medium mt-1">Stockez vos fichiers volumineux directement sur votre Drive.</p>
                    </div>
                    <div data-project-create-target="driveStatus" class="hidden flex items-center gap-2 px-4 py-2 bg-green-50 text-green-600 rounded-full text-xs font-black uppercase tracking-widest border border-green-100">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                        Connecté
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-blue-100/50 shadow-sm space-y-6">
                    {# Étape 1 : Connexion #}
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-gray-50">
                        <div class="space-y-1">
                            <p class="font-bold text-gray-900">1. Lier un compte Google</p>
                            <p class="text-xs text-gray-500 leading-relaxed">Autorisez Organ à accéder à votre stockage Google Drive.</p>
                        </div>
                        <button type="button" data-action="click->project-create#openGoogleModal"
                                class="px-8 py-4 bg-white border border-gray-200 text-gray-900 font-bold rounded-2xl hover:bg-gray-50 transition-all active:scale-95 flex items-center gap-3">
                            <svg width="18" height="18" viewBox="0 0 18 18"><path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/><path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/><path d="M3.964 10.712c-.18-.54-.282-1.117-.282-1.712s.102-1.172.282-1.712V4.956H.957A8.996 8.997 0 0 0 0 9c0 1.497.312 2.923.87 4.212l3.094-2.5z" fill="#FBBC05"/><path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.956L4.051 7.456C4.76 5.328 6.743 3.75 9 3.58z" fill="#EA4335"/></svg>
                            <span data-project-create-target="googleBtnText">Se connecter</span>
                        </button>
                    </div>

                    {# Étape 2 : Provisionnement #}
                    <div data-project-create-target="driveFolderSection" class="hidden space-y-6 pt-2">
                        <div class="space-y-1">
                            <p class="font-bold text-gray-900">2. Provisionner l'espace de stockage</p>
                            <p class="text-xs text-gray-500 leading-relaxed">Organ va créer un dossier sécurisé nommé <b>"{{ project.title }} ({{ project.uuid|slice(0,8) }})"</b> dans votre dossier <b>"Organ App"</b> sur Google Drive.</p>
                        </div>

                        {# Liste des dossiers (Aperçu) #}
                        <div class="relative min-h-[60px]">
                            <div data-project-create-target="folderLoader" class="hidden absolute inset-0 bg-white/50 backdrop-blur-[2px] flex items-center justify-center z-10 rounded-xl">
                                <div class="w-6 h-6 border-2 border-blue-600/30 border-t-blue-600 rounded-full animate-spin"></div>
                            </div>

                            <div data-project-create-target="folderList" class="grid grid-cols-1 gap-2 max-h-40 overflow-y-auto custom-scrollbar pr-2">
                                {# JS Rendered folders inside Organ App #}
                            </div>
                        </div>

                        {# Actions dossiers #}
                        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 border-t border-gray-50">
                            <button type="button" data-action="click->project-create#createNewProjectFolder"
                                    data-project-create-target="generateFolderBtn"
                                    class="w-full sm:w-auto px-10 py-4 bg-blue-600 text-white font-black uppercase tracking-widest text-xs rounded-2xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/20 active:scale-95 flex items-center justify-center gap-3 cursor-pointer">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                                Générer le dossier de stockage dédié
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="mt-8 flex items-center justify-end gap-4 px-4">
        <div data-project-create-target="error" class="hidden text-red-500 font-medium text-sm mr-auto"></div>
        <a href="{{ is_edit ? path('app_project_show', {uuid: project.uuid}) : path('app_dashboard') }}" class="px-8 py-4 bg-white border border-gray-200 text-gray-900 font-bold rounded-2xl hover:bg-gray-50 transition-all active:scale-95">
            {{ 'project.create.form.actions.cancel'|trans }}
        </a>
        <button type="button" data-project-create-target="submitBtn" data-action="click->project-create#submit"
                class="px-10 py-4 bg-bubblegum text-white font-bold rounded-2xl hover:brightness-105 transition-all shadow-lg shadow-bubblegum/20 active:scale-95 flex items-center gap-3 cursor-pointer">
            <span data-project-create-target="spinner" class="hidden animate-spin">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </span>
            {{ is_edit ? 'project.edit.form.actions.submit'|trans : 'project.create.form.actions.submit'|trans }}
        </button>
    </div>

    {% if is_edit %}
        <div class="mt-20 border-t-2 border-red-50/50 px-4">
            <div class="bg-red-50/30 rounded-3xl border border-red-100 p-8 space-y-6">
                <div>
                    <h3 class="text-xl font-bold text-red-600 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="m4.84 19 8.16-14 8.16 14H4.84Z"/></svg>
                        Zone de danger
                    </h3>
                    <p class="text-sm text-red-500/70 font-medium mt-1">Actions irréversibles pour ce projet</p>
                </div>

                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-red-100/50 shadow-sm">
                    <div class="space-y-1">
                        <p class="font-bold text-gray-900">Supprimer ce projet</p>
                        <p class="text-xs text-gray-500 leading-relaxed">Une fois supprimé, le projet sera déplacé dans la corbeille. <br>Vous pourrez le restaurer plus tard.</p>
                    </div>
                    <button type="button" data-action="click->project-create#openDeleteModal"
                            class="px-6 py-3 bg-red-50 text-red-600 font-black text-[10px] uppercase tracking-widest rounded-xl hover:bg-red-600 hover:text-white transition-all active:scale-95 border border-red-100 cursor-pointer whitespace-nowrap">
                        Supprimer le projet
                    </button>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block modals %}
    {% if project is defined %}
        {# Modal de suppression de projet #}
        <div data-project-create-target="deleteModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
            <div class="flex items-center justify-center min-h-screen p-4">
                <div class="fixed inset-0 bg-red-900/10 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-create#closeDeleteModal"></div>

                <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-red-50 transform transition-all">
                    <div class="p-10 text-center">
                        <div class="w-20 h-20 bg-red-50 rounded-3xl flex items-center justify-center text-red-500 mx-auto mb-6 border border-red-100/50">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </div>
                        
                        <h3 class="text-2xl font-black text-gray-900 mb-4">Supprimer ce projet ?</h3>
                        <p class="text-gray-500 font-medium leading-relaxed mb-8">
                            Êtes-vous sûr de vouloir supprimer le projet <span class="font-bold text-gray-900">"{{ project.title }}"</span> ? 
                            Cette action déplacera le projet dans la corbeille, mais vous pourrez le restaurer plus tard.
                        </p>

                        <div class="flex flex-col gap-3">
                            <button type="button" data-project-create-target="deleteSubmitBtn" data-action="click->project-create#deleteProject"
                                    class="w-full py-4 bg-red-600 text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-red-600/20 hover:bg-red-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                                <span data-project-create-target="deleteSpinner" class="hidden animate-spin">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                </span>
                                Confirmer la suppression
                            </button>
                            <button type="button" data-action="click->project-create#closeDeleteModal"
                                    class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                                Annuler l'opération
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Modal de connexion Google Drive #}
        <div data-project-create-target="googleModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
            <div class="flex items-center justify-center min-h-screen p-4">
                <div class="fixed inset-0 bg-blue-900/10 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-create#closeGoogleModal"></div>

                <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-blue-50 transform transition-all">
                    <div class="p-10 text-center">
                        <div class="w-20 h-20 bg-blue-50 rounded-3xl flex items-center justify-center text-blue-500 mx-auto mb-6 border border-blue-100/50">
                            <svg width="32" height="32" viewBox="0 0 18 18"><path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/><path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/><path d="M3.964 10.712c-.18-.54-.282-1.117-.282-1.712s.102-1.172.282-1.712V4.956H.957A8.996 8.997 0 0 0 0 9c0 1.497.312 2.923.87 4.212l3.094-2.5z" fill="#FBBC05"/><path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.956L4.051 7.456C4.76 5.328 6.743 3.75 9 3.58z" fill="#EA4335"/></svg>
                        </div>
                        
                        <h3 class="text-2xl font-black text-gray-900 mb-4">Lier votre compte Google ?</h3>
                        <p class="text-gray-500 font-medium leading-relaxed mb-8">
                            En liant votre compte, Organ pourra créer un dossier dédié sur votre Google Drive pour stocker les fichiers du projet <span class="font-bold text-gray-900">"{{ project.title }}"</span>.
                        </p>

                        <div class="flex flex-col gap-3">
                            <button type="button" data-action="click->project-create#connectGoogle"
                                    class="w-full py-4 bg-blue-600 text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-blue-600/20 hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                                Autoriser l'accès Google Drive
                            </button>
                            <button type="button" data-action="click->project-create#closeGoogleModal"
                                    class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                                Annuler
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}