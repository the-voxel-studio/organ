{% extends 'layouts/logged/sidebar_layout.html.twig' %}

{% block title %}Corbeille - Organ{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8" data-controller="project-trash" data-project-trash-api-url-value="/api">
    <header class="mb-12">
        <h1 class="text-4xl font-black text-black mb-2 flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-10 h-10 text-red-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            {{ 'project.trash.title'|trans }}
        </h1>
        <p class="text-gray-500 font-medium">{{ 'project.trash.subtitle'|trans }}</p>
    </header>

    {% if trashedProjects|length > 0 %}
        <div class="space-y-4">
            {% for project in trashedProjects %}
                <div class="trash-item bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex items-center justify-between gap-6 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-6 min-w-0">
                        <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-white flex-shrink-0" style="background-color: {{ project.color }}">
                            {% if project.iconData is not empty %}
                                {% if project.iconType == 'EMOJI' %}
                                    <span class="text-2xl">{{ project.iconData }}</span>
                                {% elseif project.iconType == 'BLOB' %}
                                    <img src="{{ project.iconData }}" class="w-full h-full object-cover">
                                {% elseif project.iconType == 'SVG' %}
                                    <div class="w-6 h-6">{{ project.iconData|raw }}</div>
                                {% endif %}
                            {% else %}
                                <div class="w-full h-full" style="background-color: {{ project.color }}"></div>
                            {% endif %}
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg font-bold text-black truncate">{{ project.title }}</h2>
                            <p class="text-xs text-gray-400 font-medium uppercase tracking-widest mt-1">
                                {{ 'project.trash.deleted_at'|trans({'date': project.deletedAt|date('d/m/Y à H:i')}) }}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" 
                                data-action="click->project-trash#restore"
                                data-uuid="{{ project.uuid }}"
                                class="px-6 py-3 bg-bubblegum text-white font-bold rounded-2xl cursor-pointer hover:bg-bubblegum/90 active:scale-95 transition-all shadow-lg flex items-center gap-2 whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
                            </svg>
                            {{ 'project.trash.restore_btn'|trans }}
                        </button>
                        <button type="button" 
                                data-action="click->project-trash#removePermanent"
                                data-uuid="{{ project.uuid }}"
                                class="p-3 bg-rose-50 text-rose-500 rounded-2xl hover:bg-rose-100 active:scale-95 transition-all cursor-pointer shadow-sm"
                                title="{{ 'project.trash.delete_permanent_btn'|trans }}">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="py-20 text-center bg-gray-50 rounded-[3rem] border-2 border-dashed border-gray-200">
            <div class="mb-6 inline-flex p-6 bg-white rounded-full text-gray-200 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-16 h-16">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m6 4.125 2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{{ 'project.trash.empty'|trans }}</h2>
            <p class="text-gray-500 font-medium italic">{{ 'project.trash.empty_subtitle'|trans }}</p>
        </div>
    {% endif %}

    {# Modal de suppression définitive de projet #}
    <div data-project-trash-target="hardDeleteModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-red-900/10 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-trash#closeHardDeleteModal"></div>

            <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-red-50 transform transition-all">
                <div class="p-10 text-center">
                    <div class="w-20 h-20 bg-red-50 rounded-3xl flex items-center justify-center text-red-500 mx-auto mb-6 border border-red-100/50">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">{{ 'project.trash.confirm.delete_permanent_title'|trans }}</h3>
                    <p class="text-gray-500 font-medium leading-relaxed mb-8">
                        {{ 'project.trash.confirm.delete_permanent_message'|trans|raw }}
                    </p>

                    <div class="flex flex-col gap-3">
                        <button type="button" 
                                data-project-trash-target="deleteSubmitBtn"
                                data-action="click->project-trash#confirmRemovePermanent"
                                class="w-full py-4 bg-red-600 text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-red-600/20 hover:bg-red-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                            <span data-project-trash-target="deleteSpinner" class="hidden animate-spin">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            {{ 'generic.confirm_delete_permanent'|trans }}
                        </button>
                        <button type="button" data-action="click->project-trash#closeHardDeleteModal"
                                class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                            {{ 'generic.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# Modal de restauration de projet #}
    <div data-project-trash-target="restoreModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-bubblegum/5 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-trash#closeRestoreModal"></div>

            <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-bubblegum/5 transform transition-all">
                <div class="p-10 text-center">
                    <div class="w-20 h-20 bg-bubblegum/5 rounded-3xl flex items-center justify-center text-bubblegum mx-auto mb-6 border border-bubblegum/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">{{ 'project.trash.confirm.restore_title'|trans }}</h3>
                    <div class="space-y-4 mb-8 text-left">
                        <p class="text-gray-500 font-medium leading-relaxed">
                            {{ 'project.trash.confirm.restore_message'|trans }}
                        </p>
                        <div class="p-4 bg-amber-50 rounded-2xl border border-amber-100">
                            <p class="text-[11px] font-bold text-amber-700 uppercase tracking-wider flex items-center gap-2 mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                                {{ 'project.trash.confirm.restore_warning_title'|trans }}
                            </p>
                            <p class="text-xs text-amber-600 leading-relaxed font-medium">
                                {{ 'project.trash.confirm.restore_warning_message'|trans|raw }}
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <button type="button" 
                                data-project-trash-target="restoreSubmitBtn"
                                data-action="click->project-trash#confirmRestore"
                                class="w-full py-4 bg-bubblegum text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-bubblegum/20 hover:brightness-105 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                            <span data-project-trash-target="restoreSpinner" class="hidden animate-spin">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            {{ 'project.trash.restore_btn'|trans }}
                        </button>
                        <button type="button" data-action="click->project-trash#closeRestoreModal"
                                class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                            {{ 'generic.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
