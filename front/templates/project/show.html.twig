{% extends 'layouts/logged/sidebar_layout.html.twig' %}

{% block title %}
	{{ data.project.title }}
	- Organ
{% endblock %}

{% block content %}
	<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
		<!-- Header -->
		<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-12">
			<div class="flex items-center gap-6">
				<div class="w-16 h-16 bg-white rounded-2xl shadow-sm border border-gray-100 flex items-center justify-center overflow-hidden">
					{% if data.project.iconType == 'EMOJI' %}
						<span class="text-3xl">{{ data.project.iconData }}</span>
					{% elseif data.project.iconType == 'BLOB' %}
						<img src="{{ data.project.iconData }}" class="w-full h-full object-cover">
					{% elseif data.project.iconType == 'SVG' %}
						<div class="w-8 h-8 flex items-center justify-center">{{ data.project.iconData|raw }}</div>
					{% endif %}
				</div>
				<div>
					<h1 class="text-3xl font-black text-black mb-1">{{ data.project.title }}</h1>
					<div class="flex items-center gap-3">
						<span class="px-3 py-1 bg-bubblegum/10 text-bubblegum text-[10px] font-black uppercase tracking-widest rounded-lg">
							{{ data.project.status }}
						</span>
						<span class="text-xs text-gray-400 font-medium italic">
							{{ 'project.show.role'|trans }}:
							{{ data.project.role }}
						</span>
					</div>
				</div>
			</div>
			<div class="flex items-center gap-3">
				{% if data.project.role == 'ADMIN' %}
					<a href="{{ path('app_project_edit', {uuid: data.project.uuid}) }}" class="px-6 py-3 bg-black text-white font-bold rounded-2xl transition-all hover:bg-black/90 active:scale-95 shadow-lg flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
						</svg>
						{{ 'project.show.settings'|trans }}
					</a>
				{% endif %}
			</div>
		</header>

		<div class="space-y-12">
			<!-- ROW 1: ORGANS -->
			<section>
				<div class="flex items-center justify-between mb-8 px-2">
					<h2 class="text-xl font-bold text-black flex items-center gap-3">
						<div class="p-2 bg-bubblegum/10 rounded-xl text-bubblegum">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"/>
							</svg>
						</div>
						{{ 'project.show.organs'|trans }}
					</h2>
					{% if data.project.role in ['ADMIN', 'MANAGER'] %}
						<button class="text-sm font-bold text-bubblegum hover:underline">{{ 'project.show.add_organ'|trans }}</button>
					{% endif %}
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					{% for organ in data.organs %}
						<a href="#" class="group bg-white p-6 rounded-3xl shadow-sm border border-gray-100 hover:border-bubblegum transition-all transform hover:-translate-y-1">
							<div class="w-12 h-12 rounded-2xl mb-4 flex items-center justify-center text-white" style="background-color: {{ organ.highlightColor }}">
								{% if organ.iconType == 'EMOJI' %}
									<span class="text-2xl">{{ organ.iconData }}</span>
								{% elseif organ.iconType == 'SVG' %}
									<div class="w-6 h-6">{{ organ.iconData|raw }}</div>
								{% endif %}
							</div>
							<h3 class="font-bold text-gray-900 group-hover:text-bubblegum transition-colors">{{ organ.title }}</h3>
							<p class="text-xs text-gray-400 font-medium mt-1 uppercase tracking-widest">{{ 'project.show.view_tasks'|trans }}</p>
						</a>
					{% else %}
						<div class="col-span-full py-12 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 text-center">
							<p class="text-gray-400 font-medium italic">{{ 'project.show.no_organs'|trans }}</p>
						</div>
					{% endfor %}
				</div>
			</section>

			<!-- ROW 2: DESCRIPTION & ACTIVITIES -->
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
				<!-- LEFT: DESCRIPTION -->
				<section class="lg:col-span-1">
					<h2 class="text-xl font-bold text-black mb-8 px-2 flex items-center gap-3">
						<div class="p-2 bg-highlight/10 rounded-xl text-highlight">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
							</svg>
						</div>
						{{ 'project.show.about'|trans }}
					</h2>
					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 h-fit">
						<p class="text-gray-600 leading-relaxed font-medium">
							{{ data.project.description ?: 'project.show.no_description'|trans }}
						</p>
						<div class="mt-8 pt-8 border-t border-gray-50">
							<div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest text-gray-400">
								<span>{{ 'project.show.created_at'|trans }}</span>
								<span class="text-gray-900">{{ (data.project.createdAt is defined) ? data.project.createdAt|date('d/m/Y') : '-' }}</span>
							</div>
						</div>
					</div>
				</section>

				<!-- RIGHT: ACTIVITIES -->
				<section class="lg:col-span-2">
					<h2 class="text-xl font-bold text-black mb-8 px-2 flex items-center gap-3">
						<div class="p-2 bg-green-50 rounded-xl text-green-600">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
							</svg>
						</div>
						{{ 'project.show.latest_activities'|trans }}
					</h2>
					<div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
						<div class="divide-y divide-gray-50">
							{% for activity in data.activities %}
								<div class="p-6 flex items-start gap-4 hover:bg-gray-50 transition-colors">
									<div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center flex-shrink-0 text-gray-400">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
									</div>
									<div class="flex-grow min-w-0">
										<p class="text-sm font-bold text-gray-900 truncate">
											{{ activity.user ? activity.user.firstName : 'System' }} 
											<span class="font-medium text-gray-500">{{ activity.actionType|lower }}</span> 
											{{ activity.task.title }}
										</p>
										<div class="flex items-center gap-2 mt-1">
											<span class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ activity.createdAt|date('H:i') }}</span>
											<span class="text-[10px] font-bold text-bubblegum uppercase tracking-widest px-2 py-0.5 bg-bubblegum/5 rounded-md">{{ activity.fieldName ?: 'General' }}</span>
										</div>
									</div>
								</div>
							{% else %}
								<div class="p-12 text-center text-gray-400 italic font-medium">
									{{ 'project.show.no_activity'|trans }}
								</div>
							{% endfor %}
						</div>
					</div>
				</section>
			</div>

			<!-- ROW 3: SECURITY LOGS -->
			<section>
				<h2 class="text-xl font-bold text-black mb-8 px-2 flex items-center gap-3 text-red-600">
					<div class="p-2 bg-red-50 rounded-xl text-red-600">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
						</svg>
					</div>
					{{ 'project.show.security_logs'|trans }}
				</h2>
				<div class="bg-red-50/30 rounded-3xl border border-red-100 overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full">
							<tbody class="divide-y divide-red-100/50">
								{% for log in data.securityLogs %}
									<tr class="hover:bg-red-50/50 transition-colors">
										<td class="p-6">
											<div class="flex items-center gap-4">
												<div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
												<div>
													<p class="text-sm font-bold text-gray-900">
														{{ log.user ? log.user.firstName ~ ' ' ~ log.user.lastName : 'Unknown User' }}
														<span class="font-medium text-red-600/80">{{ log.actionType }}</span>
													</p>
													<p class="text-[10px] font-black uppercase tracking-widest text-red-400 mt-1">
														{{ log.createdAt|date('d/m/Y H:i') }} • Task ID: {{ log.task.uuid|slice(0, 8) }}
													</p>
												</div>
											</div>
										</td>
										<td class="p-6 text-right">
											<span class="px-3 py-1 bg-red-100 text-red-700 text-[10px] font-black uppercase tracking-widest rounded-lg border border-red-200">
												High Priority
											</span>
										</td>
									</tr>
								{% else %}
									<tr>
										<td class="p-12 text-center text-red-400/60 italic font-medium">
											{{ 'project.show.no_security_logs'|trans }}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}
