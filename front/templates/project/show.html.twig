{% extends 'layouts/logged/sidebar_layout.html.twig' %}

{% block title %}
	{{ data.project.title }}
	- Organ
{% endblock %}

{% block content %}
	{% set project_color = data.project.color|default('#FF7EB6') %}
	
	{# Background Glow - Subtile ambiance #}
	<div class="fixed top-0 right-0 w-[600px] h-[600px] rounded-full opacity-[0.05] pointer-events-none blur-[120px] -z-10" 
	     style="background-color: {{ project_color }}"></div>

	<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8"
	     data-controller="project-tags"
	     data-project-tags-project-uuid-value="{{ data.project.uuid }}"
	     data-project-tags-can-manage-value="{{ (data.project.role in ['ADMIN', 'MANAGER']) ? 'true' : 'false' }}">
		<!-- Header -->
		<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-12">
			<div class="flex items-center gap-6">
				<div class="w-16 h-16 bg-white rounded-2xl shadow-sm border-2 flex items-center justify-center overflow-hidden"
				     style="border-color: {{ project_color }}">
					{% if data.project.iconData is not empty %}
						{% if data.project.iconType == 'EMOJI' %}
							<span class="text-3xl">{{ data.project.iconData }}</span>
						{% elseif data.project.iconType == 'BLOB' %}
							<img src="{{ data.project.iconData }}" class="w-full h-full object-cover">
						{% elseif data.project.iconType == 'SVG' %}
							<div class="w-8 h-8 flex items-center justify-center">{{ data.project.iconData|raw }}</div>
						{% endif %}
					{% else %}
						<div class="w-full h-full" style="background-color: {{ project_color }}"></div>
					{% endif %}
				</div>
				<div>
					<h1 class="text-3xl font-black text-black mb-1">{{ data.project.title }}</h1>
					<div class="flex items-center gap-3">
						{% if data.project.status == 'ACTIVE' %}
							<span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-lg"
							      style="background-color: {{ project_color }}1a; color: {{ project_color }}">
								{{ 'project.status.active'|trans }}
							</span>
						{% elseif data.project.status == 'ARCHIVED' %}
							<span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-black uppercase tracking-widest rounded-lg border border-slate-200">
								{{ 'project.status.archived'|trans }}
							</span>
						{% else %}
							<span class="px-3 py-1 bg-amber-50 text-amber-600 text-[10px] font-black uppercase tracking-widest rounded-lg border border-amber-100">
								{{ 'project.status.inactive'|trans }}
							</span>
						{% endif %}
						<span class="text-xs text-gray-400 font-medium italic">
							{{ 'project.show.role'|trans }}:
							{{ data.project.role }}
						</span>
					</div>
				</div>
			</div>
			<div class="flex items-center gap-3">
				{% if data.project.role in ['ADMIN', 'MANAGER'] %}
					<a href="{{ path('app_project_specific_trash', {uuid: data.project.uuid}) }}" class="p-3 bg-white border border-gray-200 text-gray-400 hover:text-red-500 hover:border-red-100 hover:bg-red-50 rounded-2xl transition-all active:scale-95 shadow-sm group">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
						</svg>
					</a>
				{% endif %}
				{% if data.project.role == 'ADMIN' %}
					<a href="{{ path('app_project_edit', {uuid: data.project.uuid}) }}" class="px-6 py-3 bg-black text-white font-bold rounded-2xl transition-all hover:bg-black/90 active:scale-95 shadow-lg flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
						</svg>
						{{ 'project.show.settings'|trans }}
					</a>
				{% endif %}
			</div>
		</header>

		<div class="space-y-12">
			<!-- ROW 1: ORGANS -->
			<section>
				<div class="flex items-center justify-between mb-8">
					<h2 class="text-xl font-bold text-black flex items-center gap-3">
						<div class="p-2 rounded-xl" style="background-color: {{ project_color }}1a; color: {{ project_color }}">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"/>
							</svg>
						</div>
						{{ 'project.show.organs'|trans }}
					</h2>
					<div class="flex items-center gap-3">
						<button data-action="click->project-tags#togglePanel"
								class="px-5 py-3 bg-white border border-gray-100 rounded-2xl text-sm font-bold text-gray-700 hover:bg-gray-50 transition-all shadow-sm cursor-pointer group flex items-center gap-2">
							<svg class="w-4 h-4 text-gray-400 group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
							{{ (data.project.role in ['ADMIN', 'MANAGER']) ? 'project.show.manage_tags'|trans : 'project.show.tags_list_title'|trans }}
						</button>
						{% if data.project.role in ['ADMIN', 'MANAGER'] %}
							<a href="{{ path('app_organ_new', {projectUuid: data.project.uuid}) }}" class="px-6 py-3 text-white font-bold rounded-2xl transition-all hover:brightness-110 active:scale-95 shadow-lg flex items-center gap-2 cursor-pointer shadow-current/20"
									style="background-color: {{ project_color }}">{{ 'project.show.add_organ'|trans }}</a>
						{% endif %}
					</div>
				</div>

				{# --- TAGS PANEL --- #}
				<div data-project-tags-target="panel" class="hidden mb-12">
					<div class="flex items-center justify-between mb-8">
						<h3 class="text-lg font-bold text-black flex items-center gap-3">
							<div class="p-2 rounded-xl" style="background-color: {{ project_color }}1a; color: {{ project_color }}">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
							</div>
							{{ (data.project.role in ['ADMIN', 'MANAGER']) ? 'project.show.tags_title'|trans : 'project.show.tags_list_title'|trans }}
						</h3>
						
						{% if data.project.role in ['ADMIN', 'MANAGER'] %}
							<button data-action="click->project-tags#toggleForm" 
									class="px-4 py-2 bg-white border border-gray-100 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-gray-50 transition-all shadow-sm cursor-pointer"
									style="color: {{ project_color }}">
								+ {{ 'project.show.add_tag'|trans }}
							</button>
						{% endif %}
					</div>

					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
						<div data-project-tags-target="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							{# Stimulus Rendered #}
						</div>

						{% if data.project.role in ['ADMIN', 'MANAGER'] %}
							<form data-project-tags-target="form" data-action="submit->project-tags#saveTag" class="mt-8 hidden p-6 bg-gray-50/50 rounded-2xl border border-gray-100 space-y-4">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div class="space-y-2">
										<label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'project.show.tag_name'|trans }}</label>
										<input type="text" data-project-tags-target="nameInput" required placeholder="Ex: Prioritaire" 
											   class="w-full px-5 py-3 bg-white border border-gray-100 focus:border-highlight rounded-xl text-sm transition-all outline-none shadow-sm"
											   onfocus="this.style.borderColor= '{{ project_color }}'"
											   onblur="this.style.borderColor='#f3f4f6'">
									</div>
									<div class="space-y-2">
										<label class="text-[10px] font-black uppercase tracking-widest text-gray-400 ml-1">{{ 'project.show.tag_color'|trans }}</label>
										<div class="flex items-center gap-3">
											<input type="color" data-project-tags-target="colorInput" value="#808080"
												   class="w-12 h-12 bg-white border border-gray-100 rounded-xl cursor-pointer p-1 shadow-sm">
											<span class="text-xs text-gray-500 font-medium">Choisissez une couleur pour ce tag</span>
										</div>
									</div>
								</div>
								<div class="flex justify-end gap-3 pt-4">
									<button type="button" data-action="click->project-tags#toggleForm" class="px-6 py-3 text-sm font-bold text-gray-500 hover:text-gray-700 transition-colors cursor-pointer">
										Annuler
									</button>
									<button type="submit" data-project-tags-target="submitBtn" 
											class="px-8 py-3 bg-black text-white font-bold rounded-xl hover:bg-black/90 transition-all shadow-lg active:scale-95 flex items-center gap-2 cursor-pointer">
										<div data-project-tags-target="spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
										{{ 'project.show.save_tag'|trans }}
									</button>
								</div>
							</form>
						{% endif %}
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{% for organ in data.organs %}
						<a href="{{ path('app_organ_show', {projectUuid: data.project.uuid, organUuid: organ.uuid}) }}" class="group bg-white p-6 rounded-3xl shadow-sm border border-gray-100 transition-all transform hover:-translate-y-1 flex flex-col h-full"
						   style="--hover-color: {{ project_color }}">
							<div class="flex items-start justify-between mb-4">
								<div class="w-12 h-12 rounded-2xl flex items-center justify-center overflow-hidden flex-shrink-0 shadow-sm" 
								     style="background-color: {{ organ.highlightColor }}">
									{% if organ.iconData is not empty %}
										{% if organ.iconType == 'EMOJI' %}
											<span class="text-2xl">{{ organ.iconData }}</span>
										{% elseif organ.iconType == 'BLOB' %}
											<img src="{{ organ.iconData }}" class="w-full h-full object-cover">
										{% elseif organ.iconType == 'SVG' %}
											<div class="w-6 h-6 text-white">{{ organ.iconData|raw }}</div>
										{% endif %}
									{% else %}
										<div class="w-full h-full" style="background-color: {{ organ.highlightColor }}"></div>
									{% endif %}
								</div>
								<div class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-gray-100 bg-gray-50 text-gray-500">
									{{ organ.activeTasksCount }} {{ (organ.activeTasksCount > 1 ? 'tâches actives' : 'tâche active') }}
								</div>
							</div>
							
							<h3 class="font-bold text-gray-900 group-hover:text-[var(--hover-color)] transition-colors mb-2">{{ organ.title }}</h3>
							
							<p class="text-xs text-gray-500 font-medium leading-relaxed mb-6 line-clamp-2">
								{{ organ.description ?: 'Aucune description fournie.' }}
							</p>

							<div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
								<p class="text-[10px] text-gray-400 font-black uppercase tracking-widest">{{ 'project.show.view_tasks'|trans }}</p>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 group-hover:text-[var(--hover-color)] transition-colors"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
							</div>
						</a>
					{% else %}
						<div class="col-span-full py-12 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200 text-center">
							<p class="text-gray-400 font-medium italic">{{ 'project.show.no_organs'|trans }}</p>
						</div>
					{% endfor %}
				</div>
			</section>

			<!-- ROW 2: DESCRIPTION & ACTIVITIES -->
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
				<!-- LEFT: DESCRIPTION -->
				<section class="lg:col-span-1">
					<h2 class="text-xl font-bold text-black mb-8 flex items-center gap-3">
						<div class="p-2 bg-highlight/10 rounded-xl text-highlight">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
							</svg>
						</div>
						{{ 'project.show.about'|trans }}
					</h2>
					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 h-fit">
						<p class="text-gray-600 leading-relaxed font-medium">
							{{ data.project.description ?: 'project.show.no_description'|trans }}
						</p>
						<div class="mt-8 pt-8 border-t border-gray-50">
							<div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest text-gray-400">
								<span>{{ 'project.show.created_at'|trans }}</span>
								<span class="text-gray-900">{{ (data.project.createdAt is defined) ? data.project.createdAt|date('d/m/Y') : '-' }}</span>
							</div>
						</div>
					</div>
				</section>

				<!-- RIGHT: ACTIVITIES -->
				<section class="lg:col-span-2">
					<h2 class="text-xl font-bold text-black mb-8 flex items-center gap-3">
						<div class="p-2 bg-green-50 rounded-xl text-green-600">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
							</svg>
						</div>
						{{ 'project.show.latest_activities'|trans }}
					</h2>
					<div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
						<div class="divide-y divide-gray-50">
							{% for activity in data.activities %}
								<div class="p-6 flex items-start gap-4 hover:bg-gray-50 transition-colors">
									<div class="w-10 h-10 rounded-xl bg-white border border-gray-100 flex items-center justify-center flex-shrink-0 text-bubblegum font-black text-sm uppercase shadow-sm">
										{{ activity.user_first_name|first|upper }}{{ activity.user_last_name|first|upper }}
									</div>
									<div class="flex-grow min-w-0">
										<p class="text-sm text-gray-600 leading-snug">
											<span class="font-bold text-gray-900">{{ activity.user_first_name }} {{ activity.user_last_name }}</span>
                                            
                                            {% if activity.type == 'COMMENT' %}
                                                {{ 'task.history.actions.COMMENT_ADD'|trans }}
                                            {% elseif activity.type == 'ATTACHMENT' %}
                                                {{ 'task.history.actions.ATTACHMENT_ADD'|trans }}
                                            {% elseif activity.type == 'HISTORY' %}
                                                {% set action_key = activity.action_type %}
                                                {% if activity.action_type == 'UPDATE' %}
                                                    {% if activity.field_name == 'status' %}{% set action_key = 'STATUS_CHANGE' %}
                                                    {% elseif activity.field_name == 'priority' %}{% set action_key = 'PRIORITY_CHANGE' %}
                                                    {% endif %}
                                                {% endif %}
                                                
                                                {{ ('task.history.actions.' ~ action_key)|trans }}
                                                
                                                {% if activity.field_name and action_key == 'UPDATE' %}
                                                    {{ ('task.modal.fields.' ~ activity.field_name)|trans|lower }}
                                                {% endif %}
                                            {% endif %}

											sur <span class="font-bold text-gray-900">{{ activity.task_title }}</span>
                                            <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 block mt-1">dans {{ activity.organ_title }}</span>
										</p>
										<div class="flex items-center gap-2 mt-2">
											<span class="text-[10px] font-black uppercase tracking-widest text-gray-400">{{ activity.created_at|date('H:i') }}</span>
											<span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-md"
											      style="background-color: {{ project_color }}1a; color: {{ project_color }}">{{ ('task.history.types.' ~ activity.type)|trans }}</span>
										</div>
									</div>
								</div>
							{% else %}
								<div class="p-12 text-center text-gray-400 italic font-medium">
									{{ 'project.show.no_activity'|trans }}
								</div>
							{% endfor %}
						</div>
					</div>
				</section>
			</div>
		</div>
	</div>
{% endblock %}