{% extends 'layouts/logged/sidebar_layout.html.twig' %}

{% block title %}{{ 'project.trash.specific.title'|trans }} - {{ project.title }}{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8" 
     data-controller="project-specific-trash" 
     data-project-specific-trash-api-url-value="/api"
     data-project-specific-trash-project-uuid-value="{{ project.uuid }}">
    
    <header class="mb-12">
        {% if app.request.query.get('restored') %}
            <div class="mb-10 p-6 bg-amber-50 rounded-[2rem] border-2 border-dashed border-amber-200 flex items-start gap-6 animate-in fade-in slide-in-from-top-4 duration-700">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-amber-500 shadow-sm shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-amber-900 mb-1">{{ 'project.trash.specific.restored_success_title'|trans }}</h3>
                    <p class="text-sm text-amber-700 leading-relaxed font-medium">
                        {{ 'project.trash.specific.restored_success_message'|trans|raw }}
                    </p>
                </div>
            </div>
        {% endif %}

        <div class="flex items-center justify-between mb-6">
            <a href="{{ path('app_project_show', {uuid: project.uuid}) }}" class="flex items-center gap-2 text-sm font-bold text-gray-400 hover:text-black transition-colors group">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 group-hover:-translate-x-1 transition-transform">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                {{ 'project.trash.specific.back_to_project'|trans }}
            </a>
        </div>

        <div class="flex items-end justify-between">
            <div>
                <h1 class="text-4xl font-black text-black mb-2 flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-10 h-10 text-red-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    {{ 'project.trash.specific.title'|trans }}
                </h1>
                <p class="text-gray-500 font-medium italic">{{ 'project.trash.specific.subtitle'|trans }}</p>
            </div>
            
            <div class="relative w-64">
                <input type="text" 
                       data-project-specific-trash-target="searchInput"
                       data-action="input->project-specific-trash#search"
                       placeholder="{{ 'project.trash.specific.search_placeholder'|trans }}" 
                       class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-100 rounded-2xl text-sm transition-all focus:border-red-500 outline-none shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </div>
        </div>
    </header>

    {% if trashedOrgans|length > 0 or trashedMembers|length > 0 or trashedTags|length > 0 %}
        
        {# --- ORGANS SECTION --- #}
        <section data-project-specific-trash-target="organsSection" class="trash-section mb-12 {% if trashedOrgans|length == 0 %}hidden{% endif %}">
            <button type="button" 
                    data-action="click->project-specific-trash#toggleSection"
                    class="w-full flex items-center justify-between mb-6 group cursor-pointer">
                <h2 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                    <span class="w-8 h-[1px] bg-gray-100"></span>
                    {{ 'project.trash.specific.sections.organs'|trans }}
                </h2>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-gray-300 group-hover:text-black transition-all transform rotate-0" data-project-specific-trash-target="chevron">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            <div class="space-y-4" data-project-specific-trash-target="content">
                {% for organ in trashedOrgans %}
                    <div class="trash-item bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex items-center justify-between gap-6 hover:shadow-md transition-all duration-300"
                         data-project-specific-trash-target="item"
                         data-type="organ"
                         data-search="{{ organ.title }}">
                        <div class="flex items-center gap-6 min-w-0">
                            <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-500 shrink-0 border border-indigo-100">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-lg font-bold text-black truncate">{{ organ.title }}</h3>
                                <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mt-1">
                                    {{ 'project.trash.specific.actions.deleted_at'|trans({'date': organ.deletedAt|date('d/m/Y à H:i')}) }}
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" 
                                    data-action="click->project-specific-trash#openRestoreModal"
                                    data-type="organ"
                                    data-uuid="{{ organ.uuid }}"
                                    data-title="{{ organ.title }}"
                                    class="px-5 py-2.5 bg-black text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                                {{ 'project.trash.specific.actions.restore'|trans }}
                            </button>
                            <button type="button" 
                                    data-action="click->project-specific-trash#openHardDeleteModal"
                                    data-type="organ"
                                    data-uuid="{{ organ.uuid }}"
                                    data-title="{{ organ.title }}"
                                    class="p-2.5 bg-rose-50 text-rose-500 rounded-xl hover:bg-rose-100 active:scale-95 transition-all cursor-pointer"
                                    title="{{ 'project.trash.delete_permanent_btn'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                </svg>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# --- MEMBERS SECTION --- #}
        <section data-project-specific-trash-target="membersSection" class="trash-section mb-12 {% if trashedMembers|length == 0 %}hidden{% endif %}">
            <div class="flex items-center justify-between mb-6">
                <button type="button" 
                        data-action="click->project-specific-trash#toggleSection"
                        class="flex items-center group cursor-pointer">
                    <h2 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                        <span class="w-8 h-[1px] bg-gray-100"></span>
                        {{ 'project.trash.specific.sections.members'|trans }}
                    </h2>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-gray-300 group-hover:text-black transition-all transform rotate-0 ml-2" data-project-specific-trash-target="chevron">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <div class="flex items-center gap-3">
                    <button type="button" 
                            data-action="click->project-specific-trash#selectAllMembers"
                            class="text-[10px] font-black uppercase tracking-widest text-gray-400 hover:text-black transition-colors">
                        {{ 'project.trash.specific.actions.select_all'|trans }}
                    </button>
                    <button type="button" 
                            data-project-specific-trash-target="bulkRestoreBtn"
                            data-action="click->project-specific-trash#openBulkRestoreModal"
                            class="hidden px-4 py-2 bg-bubblegum text-white text-[10px] font-black uppercase tracking-widest rounded-xl shadow-lg shadow-bubblegum/20 hover:brightness-105 active:scale-95 transition-all flex items-center gap-2">
                        {{ 'project.trash.specific.actions.restore_selection'|trans }}
                    </button>
                </div>
            </div>

            <div class="space-y-4" data-project-specific-trash-target="content">
                {% set deletion_counts = {} %}
                {% for member in trashedMembers %}
                    {% set d_at = member.deletedAt|date('Y-m-d H:i') %}
                    {% set deletion_counts = deletion_counts|merge({ (d_at): (deletion_counts[d_at]|default(0) + 1) }) %}
                {% endfor %}

                {% for member in trashedMembers %}
                    {% set d_at = member.deletedAt|date('Y-m-d H:i') %}
                    {% set is_batch = deletion_counts[d_at]|default(0) > 1 %}
                    <div class="trash-item bg-white p-6 rounded-3xl shadow-sm border {{ is_batch ? 'border-amber-100 bg-amber-50/10' : 'border-gray-100' }} flex items-center justify-between gap-6 hover:shadow-md transition-all duration-300 group/item"
                         data-project-specific-trash-target="item"
                         data-type="member"
                         data-uuid="{{ member.uuid }}"
                         data-title="{{ member.user.firstName }} {{ member.user.lastName }}"
                         data-search="{{ member.user.firstName }} {{ member.user.lastName }} {{ member.user.email }}">
                        
                        <div class="flex items-center gap-6 min-w-0">
                            <div class="relative flex items-center justify-center">
                                <input type="checkbox" 
                                       data-project-specific-trash-target="memberCheckbox"
                                       data-action="change->project-specific-trash#updateBulkBtnVisibility"
                                       class="w-5 h-5 rounded-lg border-2 border-gray-200 text-bubblegum focus:ring-bubblegum transition-all cursor-pointer"
                                       {{ is_batch ? 'checked' : '' }}>
                            </div>

                            <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 shrink-0 border border-amber-100">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-lg font-bold text-black truncate">{{ member.user.firstName }} {{ member.user.lastName }}</h3>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <p class="text-xs text-gray-500 font-medium">{{ 'project.trash.specific.actions.previous_role'|trans({'role': member.role}) }} • {{ member.user.email }}</p>
                                    <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 {{ is_batch ? 'bg-amber-100 text-amber-600' : 'bg-gray-100 text-gray-400' }} rounded-lg">
                                        {{ 'project.trash.specific.actions.removed_at'|trans({'date': member.deletedAt|date('d/m/Y à H:i')}) }}
                                        {{ is_batch ? ('• ' ~ 'project.trash.specific.actions.batch_label'|trans) : '' }}
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" 
                                    data-action="click->project-specific-trash#openRestoreModal"
                                    data-type="member"
                                    data-uuid="{{ member.uuid }}"
                                    data-title="{{ member.user.firstName }} {{ member.user.lastName }}"
                                    class="px-5 py-2.5 bg-black text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                                {{ 'project.trash.specific.actions.restore'|trans }}
                            </button>
                            <button type="button" 
                                    data-action="click->project-specific-trash#openHardDeleteModal"
                                    data-type="member"
                                    data-uuid="{{ member.uuid }}"
                                    data-title="{{ member.user.firstName }} {{ member.user.lastName }}"
                                    class="p-2.5 bg-rose-50 text-rose-500 rounded-xl hover:bg-rose-100 active:scale-95 transition-all cursor-pointer"
                                    title="{{ 'project.trash.delete_permanent_btn'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                </svg>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# --- TAGS SECTION --- #}
        <section data-project-specific-trash-target="tagsSection" class="trash-section mb-12 {% if trashedTags|length == 0 %}hidden{% endif %}">
            <button type="button" 
                    data-action="click->project-specific-trash#toggleSection"
                    class="w-full flex items-center justify-between mb-6 group cursor-pointer">
                <h2 class="text-xs font-black uppercase tracking-[0.2em] text-gray-400 flex items-center gap-3">
                    <span class="w-8 h-[1px] bg-gray-100"></span>
                    {{ 'project.trash.specific.sections.tags'|trans }}
                </h2>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-gray-300 group-hover:text-black transition-all transform rotate-0" data-project-specific-trash-target="chevron">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
            <div class="space-y-4" data-project-specific-trash-target="content">
                {% for tag in trashedTags %}
                    <div class="trash-item bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex items-center justify-between gap-6 hover:shadow-md transition-all duration-300"
                         data-project-specific-trash-target="item"
                         data-type="tag"
                         data-search="{{ tag.name }}">
                        <div class="flex items-center gap-6 min-w-0">
                            <div class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 border border-gray-100 shadow-sm" style="background-color: {{ tag.color }}20">
                                <div class="w-4 h-4 rounded-full" style="background-color: {{ tag.color }}"></div>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-lg font-bold text-black truncate" title="{{ tag.name }}">{{ tag.name }}</h3>
                                <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mt-1">
                                    {{ 'project.trash.specific.actions.deleted_at'|trans({'date': tag.deletedAt|date('d/m/Y à H:i')}) }}
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" 
                                    data-action="click->project-specific-trash#openRestoreModal"
                                    data-type="tag"
                                    data-uuid="{{ tag.uuid }}"
                                    data-title="{{ tag.name }}"
                                    class="px-5 py-2.5 bg-black text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                                {{ 'project.trash.specific.actions.restore'|trans }}
                            </button>
                            <button type="button" 
                                    data-action="click->project-specific-trash#openHardDeleteModal"
                                    data-type="tag"
                                    data-uuid="{{ tag.uuid }}"
                                    data-title="{{ tag.name }}"
                                    class="p-2.5 bg-rose-50 text-rose-500 rounded-xl hover:bg-rose-100 active:scale-95 transition-all cursor-pointer"
                                    title="{{ 'project.trash.delete_permanent_btn'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                </svg>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

    {% else %}
        <div class="py-20 text-center bg-gray-50 rounded-[3rem] border-2 border-dashed border-gray-200">
            <div class="mb-6 inline-flex p-6 bg-white rounded-full text-gray-200 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-16 h-16">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m6 4.125 2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{{ 'project.trash.specific.empty'|trans }}</h2>
            <p class="text-gray-500 font-medium italic">{{ 'project.trash.specific.empty_subtitle'|trans }}</p>
        </div>
    {% endif %}

    {# Modal de suppression définitive #}
    <div data-project-specific-trash-target="hardDeleteModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-red-900/10 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-specific-trash#closeHardDeleteModal"></div>

            <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-red-50 transform transition-all">
                <div class="p-10 text-center">
                    <div class="w-20 h-20 bg-red-50 rounded-3xl flex items-center justify-center text-red-500 mx-auto mb-6 border border-red-100/50">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">{{ 'generic.confirm_delete_permanent'|trans }}</h3>
                    <p class="text-gray-500 font-medium leading-relaxed mb-8">
                        {{ 'project.trash.specific.confirm.delete_permanent_message'|trans({'title': '<span data-project-specific-trash-target="deleteModalTitle" class="font-bold text-gray-900"></span>'})|raw }}
                    </p>

                    <div class="flex flex-col gap-3">
                        <button type="button" 
                                data-project-specific-trash-target="deleteSubmitBtn"
                                data-action="click->project-specific-trash#confirmRemovePermanent"
                                class="w-full py-4 bg-red-600 text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-red-600/20 hover:bg-red-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                            <span data-project-specific-trash-target="deleteSpinner" class="hidden animate-spin">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            {{ 'generic.confirm_delete_permanent'|trans }}
                        </button>
                        <button type="button" data-action="click->project-specific-trash#closeHardDeleteModal"
                                class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                            {{ 'generic.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modal de restauration #}
    <div data-project-specific-trash-target="restoreModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-bubblegum/5 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-specific-trash#closeRestoreModal"></div>

            <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-bubblegum/5 transform transition-all">
                <div class="p-10 text-center">
                    <div class="w-20 h-20 bg-bubblegum/5 rounded-3xl flex items-center justify-center text-bubblegum mx-auto mb-6 border border-bubblegum/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">{{ 'project.trash.specific.actions.restore'|trans }} ?</h3>
                    <p class="text-gray-500 font-medium leading-relaxed mb-8">
                        {{ 'project.trash.specific.confirm.restore_message'|trans({'title': '<span data-project-specific-trash-target="restoreModalTitle" class="font-bold text-gray-900"></span>'})|raw }}
                    </p>

                    <div class="flex flex-col gap-3">
                        <button type="button" 
                                data-project-specific-trash-target="restoreSubmitBtn"
                                data-action="click->project-specific-trash#confirmRestore"
                                class="w-full py-4 bg-bubblegum text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-bubblegum/20 hover:brightness-105 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                            <span data-project-trash-target="restoreSpinner" class="hidden animate-spin">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            {{ 'project.trash.specific.actions.restore'|trans }}
                        </button>
                        <button type="button" data-action="click->project-specific-trash#closeRestoreModal"
                                class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                            {{ 'generic.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modal de restauration GROUPÉE #}
    <div data-project-specific-trash-target="bulkRestoreModal" class="hidden fixed inset-0 z-[110] overflow-y-auto" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="fixed inset-0 bg-bubblegum/5 backdrop-blur-sm transition-opacity cursor-pointer" data-action="click->project-specific-trash#closeBulkRestoreModal"></div>

            <div class="relative z-10 bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden border border-bubblegum/5 transform transition-all">
                <div class="p-10 text-center">
                    <div class="w-20 h-20 bg-bubblegum/5 rounded-3xl flex items-center justify-center text-bubblegum mx-auto mb-6 border border-bubblegum/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">{{ 'project.trash.specific.confirm.bulk_restore_title'|trans }}</h3>
                    <p class="text-gray-500 font-medium leading-relaxed mb-8">
                        {{ 'project.trash.specific.confirm.bulk_restore_message'|trans({'count': '<span data-project-specific-trash-target="bulkCount" class="font-bold text-gray-900"></span>'})|raw }}
                    </p>

                    <div class="flex flex-col gap-3">
                        <button type="button" 
                                data-project-specific-trash-target="bulkRestoreSubmitBtn"
                                data-action="click->project-specific-trash#confirmBulkRestore"
                                class="w-full py-4 bg-bubblegum text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-bubblegum/20 hover:brightness-105 active:scale-[0.98] transition-all flex items-center justify-center gap-3 cursor-pointer">
                            <span data-project-specific-trash-target="bulkRestoreSpinner" class="hidden animate-spin">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            {{ 'project.trash.specific.actions.restore'|trans }}
                        </button>
                        <button type="button" data-action="click->project-specific-trash#closeBulkRestoreModal"
                                class="w-full py-4 bg-gray-50 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 transition-all cursor-pointer">
                            {{ 'generic.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
