# Define variables for the test environment
KERNEL_CLASS=App\Kernel
DATABASE_URL="mysql://app_user:app_password@database:3306/app_database?serverVersion=8.0&charset=utf8mb4"
REDIS_URL=redis://valkey:6379
MONGODB_URI="mongodb://root:mongodb_root_password@mongodb:27017/?authSource=admin"
